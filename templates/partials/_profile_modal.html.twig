<style>


    @import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@400;500;600&display=swap');
    @import url('https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css');

    :root {
        --bg-primary: #0a0a0f;
        --bg-card: #13131f;
        --bg-hover: #1a1a2e;
        --bg-input: #16162a;
        --accent: #7c6af7;
        --accent-2: #f97066;
        --accent-3: #34d399;
        --accent-glow: rgba(124, 106, 247, 0.3);
        --text-primary: #f0f0ff;
        --text-secondary: #8888aa;
        --text-muted: #555570;
        --border: rgba(124, 106, 247, 0.2);
        --border-subtle: rgba(255,255,255,0.07);
        --radius: 12px;
        --radius-lg: 20px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        font-family: 'DM Sans', sans-serif;
        background: var(--bg-primary);
        color: var(--text-primary);
    }

    /* faux-viewport trick */
    .scene {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.75);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        z-index: 2000;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease;
        /* supprime min-height, border-radius */
    }

    .scene::before {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
    }

    .scene.active {
        opacity: 1;
        pointer-events: all;
    }

    .scene .modal-box {
        max-height: 85vh;
        transform: scale(0.95) translateY(16px);
        transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .scene.active .modal-box {
        transform: scale(1) translateY(0);
    }

    /* modal box */
    .modal-box {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        width: 100%;
        max-width: 420px;
        max-height: 85vh;
        overflow: hidden;
        position: relative;
        display: flex;
        flex-direction: column;
    }

    /* banner */
    .profile-banner {
        height: 110px;
        background: linear-gradient(135deg, rgba(124,106,247,0.35) 0%, rgba(249,112,102,0.2) 60%, rgba(52,211,153,0.1) 100%);
        position: relative;
        flex-shrink: 0; /* empêche la bannière de rétrécir */
        overflow: visible; /* laisse l'avatar déborder */
        z-index: 1;
    }

    .banner-pattern {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 20% 50%, rgba(124,106,247,0.25) 0%, transparent 50%),
        radial-gradient(circle at 80% 30%, rgba(249,112,102,0.2) 0%, transparent 40%);
    }

    .modal-close {
        position: absolute;
        top: 12px; right: 12px;
        background: rgba(0,0,0,0.4);
        border: 1px solid var(--border-subtle);
        color: var(--text-secondary);
        width: 32px; height: 32px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        transition: all 0.2s;
        z-index: 10;
    }

    .modal-close:hover { background: rgba(255,255,255,0.15); color: var(--text-primary); }

    /* avatar */
    .avatar-wrap {
        position: absolute;
        bottom: -40px; left: 24px;
    }

    .avatar-ring {
        width: 80px; height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--accent), var(--accent-2));
        padding: 3px;
    }

    .avatar-inner {
        width: 100%; height: 100%;
        border-radius: 50%;
        overflow: hidden;
        border: 3px solid var(--bg-card);
        background: var(--bg-hover);
        display: flex; align-items: center; justify-content: center;
        font-family: 'Syne', sans-serif;
        font-size: 28px;
        font-weight: 800;
        color: var(--accent);
    }
    .modal-avatar {
        width: 82px;
        height: 82px;
        border-radius: 50%;
        object-fit: cover;
        transition: border-color var(--transition);
        display: block;
    }

    /* modal body */

    .modal-body {
        padding: 52px 24px 24px;
        overflow-y: auto;
        flex: 1;
        scrollbar-width: thin;
        scrollbar-color: var(--accent) transparent;
    }

    /* name + badge */
    .profile-name {
        font-family: 'Syne', sans-serif;
        font-size: 1.25rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 3px;
        letter-spacing: -0.02em;
    }

    .verified-badge {
        color: var(--accent);
        font-size: 14px;
    }

    .profile-handle {
        font-size: 0.82rem;
        color: var(--text-muted);
        margin-bottom: 14px;
    }

    /* stats row */
    .stats-row {
        display: flex;
        gap: 0;
        background: var(--bg-input);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius);
        overflow: hidden;
        margin-bottom: 20px;
    }

    .stat-item {
        flex: 1;
        padding: 12px 8px;
        text-align: center;
        cursor: pointer;
        transition: background 0.2s;
        position: relative;
    }

    .stat-item + .stat-item::before {
        content: '';
        position: absolute;
        left: 0; top: 20%; bottom: 20%;
        width: 1px;
        background: var(--border-subtle);
    }

    .stat-item:hover { background: var(--bg-hover); }

    .stat-value {
        font-family: 'Syne', sans-serif;
        font-size: 1rem;
        font-weight: 800;
        background: linear-gradient(135deg, var(--accent), var(--accent-2));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .stat-label {
        font-size: 0.72rem;
        color: var(--text-muted);
        margin-top: 2px;
    }

    /* nav tabs */
    .profile-tabs {
        display: flex;
        gap: 4px;
        margin-bottom: 18px;
        background: var(--bg-input);
        border-radius: var(--radius);
        padding: 4px;
    }

    .tab-btn {
        flex: 1;
        padding: 8px 4px;
        background: transparent;
        border: none;
        border-radius: 8px;
        color: var(--text-muted);
        font-family: 'DM Sans', sans-serif;
        font-size: 0.8rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .tab-btn:hover { color: var(--text-secondary); }
    .tab-btn.active {
        background: var(--bg-hover);
        color: var(--accent);
        border: 1px solid var(--border);
    }

    /* tab content */
    .tab-content { display: none; }
    .tab-content.active { display: block; }

    /* menu items */
    .menu-list {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-bottom: 16px;
    }

    .menu-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.15s;
        font-size: 0.88rem;
        color: var(--text-secondary);
        border: 1px solid transparent;
    }

    .menu-item:hover {
        background: var(--bg-hover);
        border-color: var(--border-subtle);
        color: var(--text-primary);
    }

    .menu-item i {
        font-size: 16px;
        width: 20px;
        text-align: center;
        flex-shrink: 0;
    }

    .menu-item .menu-arrow {
        margin-left: auto;
        font-size: 12px;
        color: var(--text-muted);
        transition: transform 0.15s;
    }

    .menu-item:hover .menu-arrow { transform: translateX(3px); }

    .menu-item-badge {
        margin-left: auto;
        background: var(--accent);
        color: #fff;
        font-size: 0.68rem;
        font-weight: 600;
        padding: 2px 7px;
        border-radius: 100px;
        letter-spacing: 0.02em;
    }

    .menu-separator {
        height: 1px;
        background: var(--border-subtle);
        margin: 8px 0;
    }

    .menu-item.danger { color: #f97066; }
    .menu-item.danger:hover { background: rgba(249,112,102,0.08); border-color: rgba(249,112,102,0.2); }
    .menu-item.danger i { color: #f97066; }

    /* plan badge */
    .plan-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: linear-gradient(135deg, rgba(124,106,247,0.2), rgba(249,112,102,0.15));
        border: 1px solid rgba(124,106,247,0.35);
        border-radius: 100px;
        padding: 3px 10px;
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--accent);
        margin-bottom: 20px;
    }

    /* recent videos tab */
    .video-row {
        display: flex;
        gap: 10px;
        align-items: center;
        padding: 8px;
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.15s;
        margin-bottom: 6px;
    }

    .video-row:hover { background: var(--bg-hover); }

    .video-row-thumb {
        width: 68px; height: 38px;
        border-radius: 6px;
        overflow: hidden;
        flex-shrink: 0;
        background: var(--bg-hover);
        display: flex; align-items: center; justify-content: center;
        font-size: 11px;
        color: var(--text-muted);
    }

    .video-row-title {
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--text-primary);
        line-height: 1.35;
        flex: 1;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .video-row-views { font-size: 0.72rem; color: var(--text-muted); margin-top: 2px; }

    /* settings tab */
    .setting-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid var(--border-subtle);
        font-size: 0.85rem;
    }

    .setting-row:last-child { border-bottom: none; }

    .setting-label { color: var(--text-secondary); }

    .toggle {
        width: 36px; height: 20px;
        background: var(--bg-hover);
        border: 1px solid var(--border-subtle);
        border-radius: 100px;
        cursor: pointer;
        position: relative;
        transition: background 0.2s;
    }

    .toggle.on { background: var(--accent); border-color: var(--accent); }

    .toggle::after {
        content: '';
        position: absolute;
        top: 2px; left: 2px;
        width: 14px; height: 14px;
        background: #fff;
        border-radius: 50%;
        transition: transform 0.2s;
    }

    .toggle.on::after { transform: translateX(16px); }

    .live-panel {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .live-status-card {
        background: var(--bg-input);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius);
        padding: 12px;
    }

    .live-status-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 10px;
    }

    .live-status-title {
        color: var(--text-primary);
        font-size: 0.86rem;
        font-weight: 700;
    }

    .live-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #ff4444;
        color: #fff;
        font-size: 0.68rem;
        font-weight: 800;
        padding: 3px 8px;
        border-radius: 100px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .live-key-box {
        display: flex;
        gap: 6px;
    }

    .live-key-input,
    .live-form-input {
        width: 100%;
        min-width: 0;
        background: var(--bg-hover);
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        color: var(--text-primary);
        font-family: 'DM Sans', sans-serif;
        font-size: 0.78rem;
        padding: 9px 10px;
        outline: none;
    }

    .live-key-input {
        font-family: monospace;
        color: var(--accent-3);
    }

    .live-form {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .live-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .btn-live-icon {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        border-radius: 8px;
        border: 1px solid var(--border-subtle);
        background: var(--bg-hover);
        color: var(--text-secondary);
        cursor: pointer;
    }

    .btn-live-danger {
        background: rgba(255,68,68,0.12);
        color: #ff8888;
        border-color: rgba(255,68,68,0.25);
    }

    .live-muted {
        color: var(--text-muted);
        font-size: 0.76rem;
        line-height: 1.45;
    }

    /* footer actions */
    .modal-footer-actions {
        display: flex;
        gap: 8px;
        padding-top: 4px;
    }

    .btn-outline {
        flex: 1;
        padding: 9px;
        border: 1px solid var(--border-subtle);
        background: transparent;
        color: var(--text-secondary);
        border-radius: 100px;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.82rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
        display: flex; align-items: center; justify-content: center; gap: 6px;
    }

    .btn-outline:hover { border-color: var(--accent); color: var(--accent); }

    .btn-primary-sm {
        flex: 1;
        padding: 9px;
        background: var(--accent);
        border: none;
        color: #fff;
        border-radius: 100px;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: flex; align-items: center; justify-content: center; gap: 6px;
    }

    .btn-primary-sm:hover { background: #6b59e8; }

	</style>
	<div class="scene" id="profileScene">
	    <div class="modal-box">

        <!-- Banner -->
        <div class="profile-banner">
            {% if app.user and app.user.bannerpath %}
            <img src="{{ asset (app.user.bannerpath)}}" alt="banner"
                style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">
            {% else %}
            <div class="banner-pattern">

            </div>
            {% endif %}
            <button class="modal-close" onclick="toggleProfileModal()">
                <i class="bi bi-x-lg"></i>
            </button>
            <div class="avatar-wrap">
                <div class="avatar-ring">
                    {% if app.user and app.user.pfppath %}
                    <div class="avatar-inner"> <img src="{{ asset(app.user.pfppath) }}" class="modal-avatar" alt="avatar"></div>
                    {% else %}
                    <div class="avatar-inner"><img src="{{ asset('uploads/ProfilePictures/default-avatar-profile-icon-vector-social-media-user-portrait.webp') }}"  class="modal-avatar" alt="avatar"> </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Body -->
        <div class="modal-body">
            {% set activeLive = currentUserLive|default(null) %}

            <div style="display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:6px;">
                <div>
                    <div class="profile-name">
                        {% if app.user %}
                        {{ app.user.pseudo }}
                        {% else %}
                        Invité
                        {% endif %}
                        <i class="bi bi-patch-check-fill verified-badge"></i>
                    </div>
                    <div class="profile-handle">{% if app.user %}membre depuis {{ app.user.JoinDate|date("d/m/y") }}{% else %}invité{% endif %}</div>
                </div>
                <div class="plan-chip">
                    <i class="bi bi-stars" style="font-size:12px"></i> Pro
                </div>
            </div>

            <!-- Stats -->
            <div class="stats-row">
                <div class="stat-item">

                    <div class="stat-value">{% if app.user %} {{ app.user.uploadedVideo }}{% else %}0{% endif %}</div>

                    <div class="stat-label">Vidéos</div>
                </div>
                <div class="stat-item">

                    <div class="stat-value">{% if app.user %}{{ app.user.SUBSCRIBERS }}{% else %}0{% endif %}</div>
                    <div class="stat-label">Abonnés</div>
                </div>

            </div>

            <!-- Tabs -->
            <div class="profile-tabs">
                <button class="tab-btn active" onclick="switchTab('menu', this)">
                    <i class="bi bi-grid-3x3-gap" style="font-size:13px"></i> Menu
                </button>
                <button class="tab-btn" onclick="switchTab('videos', this)">
                    <i class="bi bi-play-circle" style="font-size:13px"></i> Vidéos
                </button>
                <button class="tab-btn" onclick="switchTab('live', this)">
                    <i class="bi bi-broadcast" style="font-size:13px"></i> Live
                </button>
                <button class="tab-btn" onclick="switchTab('settings', this)">
                    <i class="bi bi-sliders" style="font-size:13px"></i> Réglages
                </button>
            </div>

            <!-- Tab: Menu -->
            <div class="tab-content active" id="tab-menu">
                <div class="menu-list">
                    <div class="menu-item">
                        <i class="bi bi-person-circle" style="color:var(--accent)"></i>
                        Mon profil public
                        <i class="bi bi-chevron-right menu-arrow"></i>
                    </div>
                    <div class="menu-item">
                        <i class="bi bi-collection-play" style="color:var(--accent)"></i>
                        Mes vidéos
                        <span class="menu-item-badge">42</span>
                    </div>
                    <div class="menu-item">
                        <i class="bi bi-bar-chart-line" style="color:#34d399"></i>
                        Tableau de bord créateur
                        <i class="bi bi-chevron-right menu-arrow"></i>
                    </div>
                    <div class="menu-item">
                        <i class="bi bi-bookmark-fill" style="color:#f97066"></i>
                        Enregistrés
                        <i class="bi bi-chevron-right menu-arrow"></i>
                    </div>
                    <div class="menu-item">
                        <i class="bi bi-clock-history" style="color:var(--text-muted)"></i>
                        Historique de visionnage
                        <i class="bi bi-chevron-right menu-arrow"></i>
                    </div>
                </div>
                <div class="menu-separator"></div>
                <div class="menu-list">
                    <div class="menu-item">
                        <i class="bi bi-moon-stars" style="color:var(--text-muted)"></i>
                        Apparence
                        <i class="bi bi-chevron-right menu-arrow"></i>
                    </div>
                    <div class="menu-item">
                        <i class="bi bi-question-circle" style="color:var(--text-muted)"></i>
                        Aide & Support
                        <i class="bi bi-chevron-right menu-arrow"></i>
                    </div>
                    <div class="menu-item danger" onclick="location.href = '/logout';">
                        <i class="bi bi-box-arrow-right"></i>
                        Se déconnecter
                        <i class="bi bi-chevron-right menu-arrow"></i>
                    </div>
                </div>
            </div>

            <!-- Tab: Videos -->
            <div class="tab-content" id="tab-videos">
                <div class="video-row">
                    <div class="video-row-thumb"><i class="bi bi-play-fill" style="font-size:16px; color:var(--accent)"></i></div>
                    <div>
                        <div class="video-row-title">Rust pour débutants — De zéro à héros</div>
                        <div class="video-row-views">1.2M vues · 3 jours</div>
                    </div>
                </div>
                <div class="video-row">
                    <div class="video-row-thumb"><i class="bi bi-play-fill" style="font-size:16px; color:var(--accent)"></i></div>
                    <div>
                        <div class="video-row-title">Architecture microservices avec Docker</div>
                        <div class="video-row-views">334K vues · 1 semaine</div>
                    </div>
                </div>
                <div class="video-row">
                    <div class="video-row-thumb"><i class="bi bi-play-fill" style="font-size:16px; color:var(--accent)"></i></div>
                    <div>
                        <div class="video-row-title">IA en 2025 — Ce qui a vraiment changé</div>
                        <div class="video-row-views">4.1M vues · 2 semaines</div>
                    </div>
                </div>
                <div style="text-align:center; padding:12px 0 4px;">
                    <a href="#" style="color:var(--accent); font-size:0.82rem; text-decoration:none; font-weight:500;">
                        Voir toutes les vidéos <i class="bi bi-arrow-right" style="font-size:11px"></i>
                    </a>
                </div>
            </div>

            <!-- Tab: Live -->
            <div class="tab-content" id="tab-live">
                <div class="live-panel">
                    {% if app.user %}
                        <div class="live-status-card">
                            <div class="live-status-head">
                                <div class="live-status-title">Clé de live</div>
                                <form method="post" action="{{ path('live_key_generate') }}">
                                    <input type="hidden" name="regenerate" value="{{ app.user.liveStreamKey ? '1' : '0' }}">
                                    <button type="submit" class="btn-live-icon" title="{{ app.user.liveStreamKey ? 'Régénérer' : 'Créer' }}">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>
                                </form>
                            </div>
                            {% if app.user.liveStreamKey %}
                                <div class="live-muted" style="margin-bottom:6px">Serveur RTMP</div>
                                <div class="live-key-box" style="margin-bottom:8px">
                                    <input class="live-key-input" id="liveRtmpUrl" type="text" readonly value="{{ liveRtmpUrl|default('rtmp://localhost:1935/live') }}">
                                    <button class="btn-live-icon" type="button" onclick="copyInputValue('liveRtmpUrl')" title="Copier"><i class="bi bi-clipboard"></i></button>
                                </div>
                                <div class="live-muted" style="margin-bottom:6px">Clé de stream</div>
                                <div class="live-key-box">
                                    <input class="live-key-input" id="liveStreamKey" type="password" readonly value="{{ app.user.liveStreamKey }}">
                                    <button class="btn-live-icon" type="button" onclick="toggleLiveKey()" title="Afficher"><i class="bi bi-eye"></i></button>
                                    <button class="btn-live-icon" type="button" onclick="copyInputValue('liveStreamKey')" title="Copier"><i class="bi bi-clipboard"></i></button>
                                </div>
                                <div class="live-muted" style="margin-top:8px">Dans OBS, mettez le serveur RTMP ci-dessus et cette clé comme clé de stream.</div>
                            {% else %}
                                <div class="live-muted">Créez votre clé pour configurer OBS, Streamlabs ou un autre encodeur.</div>
                            {% endif %}
                        </div>

                        {% if activeLive %}
                            <div class="live-status-card">
                                <div class="live-status-head">
                                    <div>
                                        <div class="live-status-title">{{ activeLive.title }}</div>
                                        <div class="live-muted">
                                            {% if activeLive.live %}
                                                {{ activeLive.viewers }} spectateur{{ activeLive.viewers > 1 ? 's' : '' }}
                                            {% else %}
                                                En attente du flux RTMP
                                            {% endif %}
                                        </div>
                                    </div>
                                    {% if activeLive.live %}
                                        <span class="live-pill">LIVE</span>
                                    {% endif %}
                                </div>
                                <div class="modal-footer-actions">
                                    <button class="btn-outline" type="button" onclick="location.href='{{ path('app_live_watch', {'slug': activeLive.slug}) }}'">
                                        <i class="bi bi-box-arrow-up-right" style="font-size:13px"></i>
                                        Ouvrir
                                    </button>
                                    {% if activeLive.live %}
                                        <form method="post" action="{{ path('live_stop') }}" style="flex:1">
                                            <button class="btn-outline btn-live-danger" type="submit" style="width:100%">
                                                <i class="bi bi-stop-circle" style="font-size:13px"></i>
                                                Arrêter
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </div>
                        {% endif %}

                        {% if not activeLive or not activeLive.live %}
                            <form class="live-form live-status-card" method="post" action="{{ path('live_start') }}">
                                <input class="live-form-input" name="title" maxlength="128" value="Live de {{ app.user.pseudo }}" placeholder="Titre du live" required>
                                <div class="live-form-grid">
                                    <input class="live-form-input" name="category" maxlength="80" placeholder="Catégorie">
                                    <input class="live-form-input" name="thumbnail_path" maxlength="255" placeholder="Miniature URL/chemin">
                                </div>
                                <input class="live-form-input" name="playback_url" maxlength="255" placeholder="URL HLS optionnelle">
                                <button class="btn-primary-sm" type="submit">
                                    <i class="bi bi-broadcast" style="font-size:13px"></i>
                                    Préparer le live
                                </button>
                            </form>
                        {% endif %}
                    {% else %}
                        <div class="live-status-card">
                            <div class="live-status-title">Connexion requise</div>
                            <div class="live-muted">Connectez-vous pour créer une clé et lancer un live.</div>
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Tab: Settings -->
            <div class="tab-content" id="tab-settings">
                <div class="setting-row">
                    <span class="setting-label"><i class="bi bi-bell" style="margin-right:8px; color:var(--accent)"></i>Notifications push</span>
                    <div class="toggle on" onclick="this.classList.toggle('on')"></div>
                </div>
                <div class="setting-row">
                    <span class="setting-label"><i class="bi bi-eye-slash" style="margin-right:8px; color:var(--text-muted)"></i>Profil privé</span>
                    <div class="toggle" onclick="this.classList.toggle('on')"></div>
                </div>
                <div class="setting-row">
                    <span class="setting-label"><i class="bi bi-moon" style="margin-right:8px; color:var(--text-muted)"></i>Mode sombre</span>
                    <div class="toggle on" onclick="this.classList.toggle('on')"></div>
                </div>
                <div class="setting-row">
                    <span class="setting-label"><i class="bi bi-envelope" style="margin-right:8px; color:#34d399"></i>Emails digest</span>
                    <div class="toggle on" onclick="this.classList.toggle('on')"></div>
                </div>
            </div>

            <!-- Footer buttons -->
            <div class="modal-footer-actions" style="margin-top:18px">
                <button class="btn-outline" onclick="toggleProfileCustomisation();toggleProfileModal()">
                    <i class="bi bi-pencil" style="font-size:13px"></i>
                    Modifier le profil
                </button>
                <button class="btn-primary-sm" onclick="location.href = '/createvideo';">
                    <i class="bi bi-camera-video-fill" style="font-size:13px"></i>
                    Nouvelle vidéo
                </button>
            </div>

        </div>
    </div>
</div>
<script>
	    function switchTab(name, btn) {
	        document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
	        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
	        document.getElementById('tab-' + name).classList.add('active');
	        btn.classList.add('active');
	    }

        function toggleLiveKey() {
            const input = document.getElementById('liveStreamKey');
            if (!input) return;
            input.type = input.type === 'password' ? 'text' : 'password';
        }

        async function copyInputValue(id) {
            const input = document.getElementById(id);
            if (!input || !navigator.clipboard) return;
            await navigator.clipboard.writeText(input.value);
        }
	</script>
