{% extends '/base_video.html.twig' %}

{% block title %}{{ live.title }} - Starduste Live{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body { background: #08080d; }
        .live-watch { min-height: 100vh; display: grid; grid-template-columns: minmax(0, 1fr) 340px; }
        .live-main { min-width: 0; }
        .topbar { height: 58px; display: flex; align-items: center; justify-content: space-between; padding: 0 20px; border-bottom: 1px solid rgba(255,255,255,.08); background: #0b0b12; }
        .brand-link { color: #fff; text-decoration: none; font-weight: 800; letter-spacing: .02em; }
        .live-player-wrap { background: #000; aspect-ratio: 16 / 9; width: 100%; display: flex; align-items: center; justify-content: center; }
        .live-player-wrap .video-js { width: 100%; height: 100%; }
        .offline-state { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; color: rgba(255,255,255,.72); background: radial-gradient(circle at center, rgba(255,68,68,.12), #030305 58%); }
        .offline-state i { font-size: 3rem; color: #ff4444; }
        .live-detail { padding: 20px clamp(16px, 3vw, 34px) 36px; }
        .live-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; margin-bottom: 14px; }
        .live-title { margin: 0; font-size: clamp(1.35rem, 3vw, 2rem); line-height: 1.15; }
        .live-pill { display: inline-flex; align-items: center; gap: 6px; background: #ff4444; border-radius: 999px; color: #fff; padding: 5px 10px; font-size: .75rem; font-weight: 800; letter-spacing: .05em; }
        .live-dot { width: 7px; height: 7px; border-radius: 50%; background: #fff; animation: pulse 1.1s infinite; }
        @keyframes pulse { 50% { opacity: .35; transform: scale(.75); } }
        .streamer-row { display: flex; align-items: center; justify-content: space-between; gap: 14px; border-top: 1px solid rgba(255,255,255,.08); padding-top: 16px; }
        .streamer { display: flex; align-items: center; gap: 12px; min-width: 0; }
        .streamer-avatar { width: 46px; height: 46px; border-radius: 50%; overflow: hidden; background: #1d1d2d; border: 2px solid #ff4444; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .streamer-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .streamer-name { font-weight: 800; }
        .stream-meta { color: rgba(255,255,255,.58); font-size: .88rem; }
        .action-row { display: flex; gap: 8px; flex-wrap: wrap; }
        .live-action { border: 1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.06); color: #fff; border-radius: 999px; padding: 8px 13px; font-size: .86rem; }
        .about-live { margin-top: 18px; background: rgba(255,255,255,.045); border: 1px solid rgba(255,255,255,.08); border-radius: 10px; padding: 14px; color: rgba(255,255,255,.72); }
        .chat-panel { border-left: 1px solid rgba(255,255,255,.08); background: #0d0d14; display: flex; flex-direction: column; min-height: 100vh; }
        .chat-head { height: 58px; display: flex; align-items: center; justify-content: space-between; padding: 0 14px; border-bottom: 1px solid rgba(255,255,255,.08); font-weight: 800; }
        .chat-messages { flex: 1; padding: 14px; overflow: auto; display: flex; flex-direction: column; gap: 10px; color: rgba(255,255,255,.78); font-size: .9rem; }
        .chat-message strong { color: #a29bfe; margin-right: 6px; }
        .chat-input { padding: 12px; border-top: 1px solid rgba(255,255,255,.08); display: flex; gap: 8px; }
        .chat-input input { flex: 1; min-width: 0; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1); border-radius: 8px; color: #fff; padding: 9px 10px; }
        .chat-input button { width: 38px; border: none; border-radius: 8px; background: #6c5ce7; color: #fff; }
        @media (max-width: 980px) {
            .live-watch { display: block; }
            .chat-panel { min-height: 420px; border-left: none; border-top: 1px solid rgba(255,255,255,.08); }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="live-watch">
        <main class="live-main">
            <div class="topbar">
                <a href="{{ path('app_index') }}" class="brand-link">Starduste</a>
                <a href="{{ path('app_lives') }}" class="btn btn-outline-light btn-sm">Tous les lives</a>
            </div>

            <section class="live-player-wrap">
                {% if live.live and live.playbackUrl %}
                    <video id="starduste-live-player" class="video-js vjs-big-play-centered" controls autoplay muted playsinline preload="auto">
                        <source src="{{ live.playbackUrl starts with 'http' ? live.playbackUrl : asset(live.playbackUrl) }}" type="{{ live.playbackUrl ends with '.m3u8' ? 'application/x-mpegURL' : 'video/mp4' }}">
                    </video>
                {% else %}
                    <div class="offline-state">
                        <i class="bi bi-broadcast"></i>
                        <div>{{ live.live ? 'Le flux est en attente de réception.' : 'Ce live est terminé.' }}</div>
                    </div>
                {% endif %}
            </section>

            <section class="live-detail">
                <div class="live-title-row">
                    <div>
                        <h1 class="live-title syne">{{ live.title }}</h1>
                        <div class="stream-meta">
                            {% if live.category %}{{ live.category }} · {% endif %}
                            {{ live.viewers }} spectateur{{ live.viewers > 1 ? 's' : '' }}
                            {% if live.startedAt %} · lancé le {{ live.startedAt|date('d/m/Y à H:i') }}{% endif %}
                        </div>
                    </div>
                    {% if live.live %}
                        <span class="live-pill"><span class="live-dot"></span>LIVE</span>
                    {% endif %}
                </div>

                <div class="streamer-row">
                    <div class="streamer">
                        <div class="streamer-avatar">
                            {% if live.streamer and live.streamer.pfppath %}
                                <img src="{{ asset(live.streamer.pfppath) }}" alt="">
                            {% else %}
                                <i class="bi bi-person-fill"></i>
                            {% endif %}
                        </div>
                        <div>
                            <div class="streamer-name">{{ live.streamer ? live.streamer.pseudo : 'Créateur' }}</div>
                            <div class="stream-meta">{{ live.streamer ? live.streamer.subscribers : 0 }} abonnés</div>
                        </div>
                    </div>
                    <div class="action-row">
                        <button class="live-action"><i class="bi bi-bell"></i> Suivre</button>
                        <button class="live-action"><i class="bi bi-share"></i> Partager</button>
                    </div>
                </div>

                <div class="about-live">
                    {% if app.user and live.streamer and app.user.id == live.streamer.id %}
                        <strong>Configuration OBS</strong><br>
                        Serveur : <code>{{ rtmpUrl|default('rtmp://localhost:1935/live') }}</code><br>
                        Clé : <code>{{ app.user.liveStreamKey }}</code>
                    {% else %}
                        Le flux est converti automatiquement de RTMP vers HLS par Starduste.
                    {% endif %}
                </div>
            </section>
        </main>

        <aside class="chat-panel">
            <div class="chat-head">
                <span>Chat en direct</span>
                <span class="stream-meta">{{ live.viewers }}</span>
            </div>
            <div class="chat-messages" id="liveChatMessages">
                <div class="chat-message"><strong>Starduste</strong>Bienvenue dans le chat du live.</div>
                <div class="chat-message"><strong>Modération</strong>Restez respectueux et évitez le spam.</div>
            </div>
            <div class="chat-input">
                <input id="liveChatInput" type="text" placeholder="Envoyer un message">
                <button type="button" onclick="sendLiveChatMessage()"><i class="bi bi-send-fill"></i></button>
            </div>
        </aside>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        {% if live.live and live.playbackUrl %}
        videojs('starduste-live-player', { liveui: true, fluid: false });
        {% endif %}

        const liveChatName = {{ (app.user ? app.user.pseudo : 'Invité')|json_encode|raw }};

        function sendLiveChatMessage() {
            const input = document.getElementById('liveChatInput');
            const list = document.getElementById('liveChatMessages');
            const value = input.value.trim();
            if (!value) return;
            const div = document.createElement('div');
            div.className = 'chat-message';
            div.innerHTML = '<strong>' + liveChatName + '</strong>' + value.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
            list.appendChild(div);
            input.value = '';
            list.scrollTop = list.scrollHeight;
        }
    </script>
{% endblock %}
