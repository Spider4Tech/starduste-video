                    ]
                }
            });
        });

            // --- Commentaires ---
            document.getElementById('btn-comment').addEventListener('click', async function() {
                const idvideo = document.getElementById('CommentInput').dataset.videoid;
                const dataToSend = {
                    message: document.getElementById('comment_commentaire').value,
                    uuidvideo: idvideo
                };
                try {
                    const response = await fetch("/commentupload", {
                        method: 'POST',
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(dataToSend)
                    });
                    const data = await response.json();
                    console.log(data);
                    if (response.ok) {
                        document.getElementById('comment_commentaire').value = '';
                    } else {
                        alert('Error: ' + data.error);
                    }
                } catch (error) {
                    console.error('Error uploading comment:', error);
                }
            });

            function triggerPop(btn) {
                btn.classList.remove('pop');
                void btn.offsetWidth;  // force le navigateur à "oublier" l'animation pour pouvoir la rejouer
                btn.classList.add('pop');
                btn.addEventListener('animationend', () => btn.classList.remove('pop'), { once: true });
            }


            // --like et dislike--

            const btnLike = document.getElementById("btnlikevideo")
            const btnDislike = document.getElementById("btn-dislike-video")
            let nombrelike = document.getElementById("like-count")
            let nombredislike = document.getElementById(("dislike-count"))
            btnLike.addEventListener('click', async function(){
                const idVideo = btnLike.dataset.videoid
                const jsonBody = {
                        idVideo: idVideo};
                try {
                    const response = await fetch("/addvideolike", {
                        method:'POST',
                        headers: {"Content-Type": "application/json"},
                        body: JSON.stringify(jsonBody)

                    })
                    const data = await response.json();
                    console.log(data)
                    if(response.ok){
                        if (data.action === "Liked"){
                            this.classList.add('active');
                            triggerPop(this)
                            if (btnDislike.classList.contains('active') ){
                                btnDislike.classList.remove('active')
                                nombredislike.textContent = data.nombredislike;

                            }
                            nombrelike.textContent = data.nombrelike;



                        }else if (data.action === "unliked"){
                            this.classList.remove('active')
                            triggerPop(this);
                            nombrelike.textContent = data.nombrelike;
