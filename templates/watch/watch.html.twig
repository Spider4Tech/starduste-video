{# templates/video_test/controller.html.twig #}
{% extends '/base_video.html.twig' %}

{% block body %}
    <div class="container mt-5">
        <div class="row">
            <div class="col-lg-8">
                {# --- LECTEUR VIDÉO --- #}
                <div class="glass-card mb-4">
                    <div class="video-container" style="border-radius: 15px; overflow: hidden; box-shadow: 0 10px 30px rgba(108, 92, 231, 0.2);">
                        <video
                            id="starduste-player"
                            class="video-js vjs-big-play-centered vjs-fluid vjs-normalise-time-controls"
                            controls
                            preload="metadata"
                            poster="https://via.placeholder.com/1280x720/0a0a0f/6c5ce7?text=Starduste+Video">
                            <source src="{{ asset(video.VideoUrl) }}">
                        </video>
                    </div>

                    <div class="mt-4">
                        <h1 class="syne" style="font-size: 1.8rem;">{{ video.title }}</h1>

                        {# --- BARRE D'INFOS & ACTIONS --- #}
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-3">
                            <div class="text-white-50">
                                <i class="bi bi-eye-fill me-2"></i> {{ video.views }} vues • {{ "now"|date("d M. Y") }}
                            </div>

                            <div class="d-flex gap-2">
                                <button class="btn-action btn-like-video {# userLiked ? 'active' : '' #}" id="btnlikevideo" data-videoid="{{ video.id }}">
                                    <i class="bi bi-hand-thumbs-up-fill"></i>
                                    <span id="like-count">{{ video.likevid }}</span>
                                </button>
                                <button class="btn-action btn-dislike-video {# userDisliked ? 'active' : '' #}" id="btn-dislike-video" data-videoid="{{ video.id }}">
                                    <i class="bi bi-hand-thumbs-down-fill"></i>
                                    <span id="dislike-count">{{ video.dislikevid }}</span>
                                </button>
                                <button class="btn-action">
                                    <i class="bi bi-share"></i> Partager
                                </button>
                            </div>
                        </div>

                        <hr style="border-color: rgba(255,255,255,0.1); margin: 25px 0;">

                        {# --- PROFIL DE L'UPLOADEUR --- #}
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <div class="profile-placeholder me-3">
                                    {% if video.getUploader.pfppath %}
                                        <img src="{{ asset(video.uploader.Pfppath) }}" alt="Avatar" class="rounded-circle" width="48">
                                    {% else %}
                                        <img src="{{ asset('uploads/fallbacksElement/FallbackPFP.png') }}" alt="Avatar" class="rounded-circle" width="48">
                                    {% endif %}
                                </div>
                                <div>
                                    <h5 class="mb-0 syne" style="font-size: 1.1rem;">{{ video.getUploader.Pseudo }}</h5>
                                    <p class="small text-white-50 mb-0">{{ video.uploader.subscribers }} abonnés</p>
                                </div>
                            </div>
                            <button class="btn-subscribe">S'abonner</button>
                        </div>
                    </div>
                </div>

                {# --- SECTION COMMENTAIRES --- #}
                <div class="glass-card mb-5">
                    <h3 class="syne mb-4" style="font-size: 1.3rem;">Commentaires</h3>

                    {# Input nouveau commentaire #}
                    {{ form_start(CommentForm, {attr: {id: 'Commentform'}}) }}
                    <div class="d-flex gap-3 mb-5">
                        <img src="https://ui-avatars.com/api/?name=Moi&background=333&color=fff" alt="Avatar" class="rounded-circle" width="40" height="40">
                        <div id="CommentInput" class="flex-grow-1" data-videoid={{ video.id }}>
                            {{ form_widget(CommentForm.commentaire, {'attr': {'class': 'comment-input', 'id': 'actualcommentarea'}}) }}
                            {{ form_end(CommentForm) }}
                            <div class="d-flex justify-content-end mt-2">
                                <button type="button" class="btn-comment" id="btn-comment">Commenter</button>
                            </div>
                        </div>
                    </div>

                    {# Liste des commentaires #}
                    <div class="comment-list">
                        {% for Commentaire in Commentaires %}
                            <div class="d-flex gap-3 mb-4 comment-item" data-commentid="{{ Commentaire.id }}">
                                <img src="{{ Commentaire.uploaderpfp }}" alt="Avatar" class="rounded-circle" width="40" height="40">
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="fw-bold small">{{ Commentaire.uploaderUsername }}</span>
                                        <span class="text-white-50" style="font-size: 0.75rem;">il y a 2h</span>
                                    </div>
                                    <p class="mb-2" style="font-size: 0.95rem; opacity: 0.9;">{{ Commentaire.ComText }}</p>
                                    <div class="d-flex align-items-center gap-3 text-white-50 small">
                                        <button class="btn-comment-action btn-like-comment" data-commentid="{{ Commentaire.id }}" id="btnlikecomment">
                                            <i class="bi bi-hand-thumbs-up"></i>
                                            <span class="like-count" id="likecommentcount">{{ Commentaire.Likes }}</span>
                                        </button>
                                        <button class="btn-comment-action btn-dislike-comment" data-commentid="{{ Commentaire.id }}" id="btndislikecomment">
                                            <i class="bi bi-hand-thumbs-down"></i>
                                            <span class="dislike-count" id="dislikecommentcount">{{ Commentaire.Dislikes }}</span>
                                        </button>
                                        <span class="cursor-pointer" style="opacity: 0.6; transition: 0.2s;" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0.6">Répondre</span>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            {# --- COLONNE DROITE (Suggestions) --- #}
            <div class="col-lg-4">
                <div class="glass-card mb-4">
                    <h3 class="syne mb-3" style="font-size: 1.2rem; color: var(--accent-purple);">À propos du test</h3>
                    <p class="small text-white-50">Ce fichier est servi par Symfony via le dossier <code>public/uploads/videos/</code>.</p>
                    <button class="btn w-100 mt-3 btn-main">
                        <i class="bi bi-rocket-takeoff me-2"></i> Publier une vidéo
                    </button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Styles pour les boutons d'action (Like/Dislike) */
        .btn-action {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: white;
            padding: 6px 15px;
            border-radius: 30px;
            font-size: 0.9rem;
            transition: background 0.25s, border-color 0.25s, color 0.25s, transform 0.15s;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }
        .btn-action:hover {
            background: rgba(108, 92, 231, 0.2);
            border-color: var(--accent-purple);
        }

        /* État actif like — spécificité renforcée + !important pour écraser Bootstrap */
        .btn-action.btn-like-video.active,
        .btn-action.btn-like-video.active:hover {
            background: rgba(108, 92, 231, 0.25) !important;
            border-color: #a29bfe !important;
            color: #a29bfe !important;
        }
        .btn-action.btn-like-video.active i {
            filter: drop-shadow(0 0 6px #a29bfe);
        }

        /* État actif dislike — spécificité renforcée + !important pour écraser Bootstrap */
        .btn-action.btn-dislike-video.active,
        .btn-action.btn-dislike-video.active:hover {
            background: rgba(108, 92, 231, 0.12) !important;
            border-color: #6c5ce7 !important;
            color: #6c5ce7 !important;
        }
        .btn-action.btn-dislike-video.active i {
            filter: drop-shadow(0 0 6px #6c5ce7);
        }

        /* Animation pop au clic */
        @keyframes pop {
            0%   { transform: scale(1); }
            40%  { transform: scale(1.25); }
            100% { transform: scale(1); }
        }
        .btn-like-video.pop,
        .btn-dislike-video.pop {
            animation: pop 0.25s ease-out;
        }

        /* Bouton s'abonner */
        .btn-subscribe {
            background: white;
            color: black;
            border: none;
            padding: 8px 20px;
            border-radius: 30px;
            font-weight: 600;
            transition: 0.3s;
        }
        .btn-subscribe:hover {
            background: var(--accent-purple);
            color: white;
        }

        /* Input commentaire */
        .comment-input {
            width: 100%;
            background: transparent;
            border: none;
            border-bottom: 2px solid rgba(255,255,255,0.1);
            color: white;
            padding: 5px 0;
            outline: none;
            transition: 0.3s;
        }
        .comment-input:focus {
            border-bottom-color: var(--accent-purple);
        }

        .btn-comment {
            background: var(--accent-purple);
            color: white;
            border: none;
            padding: 6px 15px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .btn-main {
            background: linear-gradient(135deg, #6c5ce7, #a29bfe);
            color: white;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            padding: 10px;
        }

        /* Boutons like/dislike des commentaires */
        .btn-comment-action {
            background: transparent;
            border: none;
            color: rgba(255, 255, 255, 0.45);
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.82rem;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: all 0.2s ease;
        }
        .btn-comment-action:hover {
            background: rgba(255, 255, 255, 0.07);
            color: white;
        }
        .btn-like-comment.active {
            color: #a29bfe;
            background: rgba(108, 92, 231, 0.15);
        }
        .btn-dislike-comment.active {
            color: #fd79a8;
            background: rgba(253, 121, 168, 0.1);
        }

        .cursor-pointer { cursor: pointer; }
    </style>
{% endblock %}

{% block javascripts %}
