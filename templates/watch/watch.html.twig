    <script>

        document.addEventListener("DOMContentLoaded", async function(){
            const idvideo = document.getElementById('btnlikevideo').dataset.videoid;
            const btnLike = document.getElementById("btnlikevideo")
            const btnDislike = document.getElementById("btn-dislike-video")
            const datatosend = {
                idvideo: idvideo
            }

            try {
                const response = await fetch('/checklike', {
                    method: 'POST',
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(datatosend)
                })
                const data = await response.json();
                console.log(data);
                if (response.ok){
                    if (data.action === "Liked") {
                        btnLike.classList.add('active');
                        console.log('actif donné aux likes')



                    }
                    if (data.action === "Disliked"){
                        btnDislike.classList.add('active');
                        console.log('actif donné aux dislikes')

                    }

                    if (data.action === "nope"){
                        console.log("pas d'actifs donné")
                        return
                    }

                }
            } catch (error){
                console.error('ya un probleme la surement au niveau du controller', error)
                console.log("probleme ici je pense")

            }
        })


        //généré par ia
        document.addEventListener("DOMContentLoaded", async function() {
            // Récupère tous les IDs des commentaires de la page
            const commentIds = [...document.querySelectorAll('.comment-item')]
                .map(div => div.dataset.commentid);

            if (commentIds.length === 0) return;

            try {
                const response = await fetch('/checkcommentlikes', {
                    method: 'POST',
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ commentIds: commentIds })
                });
                const data = await response.json();
                // data.liked = [12, 45]  (ids des coms likés par l'user)
                // data.disliked = [7]    (ids des coms dislikés)

                data.liked.forEach(id => {
                    const btn = document.querySelector(`.btn-like-comment[data-commentid="${id}"]`);
                    if (btn) btn.classList.add('active');
                    console.log("bouton actif donné au commentaire${data.liked[id]}")
                });

                data.disliked.forEach(id => {
                    const btn = document.querySelector(`.btn-dislike-comment[data-commentid="${id}"]`);
                    if (btn) btn.classList.add('active');
                });

            } catch (error) { console.error(error); }
        });



        document.addEventListener('DOMContentLoaded', function() {
            var player = videojs('starduste-player', {
                playbackRates: [0.5, 1, 1.5, 2],
                fluid: true,
                controlBar: {
                    children: [
                        'playToggle',
                        'volumePanel',
                        'progressControl',
                        'currentTimeDisplay',
                        'timeDivider',
                        'durationDisplay',
                        'playbackRateMenuButton',
