                    console.error(error);
                }







            })

            btnDislike.addEventListener('click', async function(){
                const idVideo = btnLike.dataset.videoid
                const jsonBody = {
                    idVideo: idVideo};
                try {
                    const response = await fetch("/addvideodislike", {
                        method:'POST',
                        headers: {"Content-Type": "application/json"},
                        body: JSON.stringify(jsonBody)

                    })
                    const data = await response.json();
                    console.log(data)
                    if(response.ok){
                        if (data.action === "Disliked"){
                            this.classList.add('active');
                            if (btnLike.classList.contains('active')){//ne fera rien si ce n'est pas le cas
                                btnLike.classList.remove('active')
                                nombrelike.textContent = data.nombrelike;

                            }
                            triggerPop(this)
                            nombredislike.textContent = data.nombredislike;



                        }else if (data.action === "undisliked"){
                            this.classList.remove('active')
                            triggerPop(this);
                            nombredislike.textContent = data.nombredislike;
                            //TODO faire en sorte que lorsqu'on dislike et on like ça enlève le like/dislike si il y'en avait un avant
