{# templates/video_test/short.html.twig #}
{% extends '/base_video.html.twig' %}
{#short.html.twig#}

{% block title %}{{ short.title }} — Starduste{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@400;500&family=Tektur:wght@400..900&display=swap');

        :root {
            --bg-primary: #0a0a0f;
            --accent-purple: #6c5ce7;
            --accent-pink: #e84393;
            --text-main: #ffffff;
            --progress-track: rgba(255,255,255,0.15);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: var(--bg-primary);
            color: var(--text-main);
            font-family: 'DM Sans', sans-serif;
            height: 100dvh;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* ─── Layout principal ─── */
        .shorts-layout {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 24px;
            height: 100dvh;
            padding: 20px;
        }

        /* ─── Wrapper vidéo (9:16) ─── */
        .short-wrapper {
            position: relative;
            height: min(92dvh, 720px);
            aspect-ratio: 9 / 16;
            border-radius: 22px;
            overflow: hidden;
            box-shadow:
                0 0 0 1px rgba(255,255,255,0.08),
                0 30px 80px rgba(0,0,0,0.7),
                0 0 60px rgba(108,92,231,0.15);
            flex-shrink: 0;
        }

        .short-wrapper video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .short-wrapper .video-js .vjs-control-bar { display: none !important; }
        .short-wrapper .video-js .vjs-big-play-button { display: none !important; }
        .short-wrapper .video-js { border-radius: 22px; overflow: hidden; }
        .short-wrapper .video-js .vjs-tech {
            width: 100% !important;
            height: 100% !important;
            object-fit: cover !important;
        }

        /* ─── Overlay dégradé bas ─── */
        .short-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(
                to top,
                rgba(0,0,0,0.85) 0%,
                rgba(0,0,0,0.3) 35%,
                transparent 65%
            );
            pointer-events: none;
            border-radius: 22px;
        }

        /* ─── Barre de progression verticale ─── */
        .short-progress {
            position: absolute;
            top: 50%;
            right: 14px;
            transform: translateY(-50%);
            width: 3px;
            height: 55%;
            background: var(--progress-track);
            border-radius: 3px;
            cursor: pointer;
            z-index: 10;
        }
        .short-progress-fill {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 0%;
            background: linear-gradient(180deg, var(--accent-pink), var(--accent-purple));
            border-radius: 3px;
            transition: height 0.1s linear;
        }
        .short-progress-thumb {
            position: absolute;
            left: 50%;
            transform: translate(-50%, 50%);
            width: 10px;
            height: 10px;
            background: #fff;
            border-radius: 50%;
            bottom: 0%;
            box-shadow: 0 0 8px var(--accent-purple);
            transition: bottom 0.1s linear;
        }

        /* ─── Info bas ─── */
        .short-info {
            position: absolute;
            bottom: 20px;
            left: 18px;
            right: 40px;
            z-index: 10;
            pointer-events: none;
        }
        .short-badge {
            display: inline-block;
            background: var(--accent-purple);
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 3px 10px;
            border-radius: 20px;
            margin-bottom: 8px;
        }
        .short-title {
            font-family: 'Syne', sans-serif;
            font-weight: 800;
            font-size: clamp(1rem, 2.5vw, 1.3rem);
            line-height: 1.25;
            text-shadow: 0 2px 12px rgba(0,0,0,0.6);
            margin-bottom: 6px;
        }
        .short-meta {
            font-size: 0.75rem;
            color: rgba(255,255,255,0.55);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* ─── Bouton play/pause central ─── */
        .short-play-btn {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(1);
            width: 64px;
            height: 64px;
            background: rgba(255,255,255,0.12);
            backdrop-filter: blur(12px);
            border: 1.5px solid rgba(255,255,255,0.25);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 15;
            transition: transform 0.15s ease, opacity 0.2s ease;
            opacity: 0;
        }
        .short-play-btn.visible { opacity: 1; }
        .short-play-btn:hover { transform: translate(-50%, -50%) scale(1.1); }
        .short-play-btn i { font-size: 1.6rem; color: #fff; }

        /* Timer */
        .short-timer {
            position: absolute;
            top: 16px;
            left: 18px;
            z-index: 15;
            font-family: 'Tektur', monospace;
            font-size: 0.85rem;
            font-weight: 700;
            color: rgba(255,255,255,0.7);
            background: rgba(0,0,0,0.35);
            backdrop-filter: blur(8px);
            padding: 4px 10px;
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.1);
            letter-spacing: 0.05em;
        }

        /* ─── Actions droite ─── */
        .short-actions {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 28px;
        }
        .short-action-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 5px;
            cursor: pointer;
            color: rgba(255,255,255,0.75);
            transition: color 0.2s, transform 0.2s;
            background: none;
            border: none;
        }
        .short-action-btn:hover { color: #fff; transform: scale(1.12); }
        .short-action-btn .action-icon {
            width: 48px;
            height: 48px;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(8px);
            font-size: 1.2rem;
            transition: background 0.2s;
        }
        .short-action-btn:hover .action-icon {
            background: rgba(108,92,231,0.3);
            border-color: var(--accent-purple);
        }
        .short-action-btn span { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.03em; }

        /* États actifs like/dislike */
        .short-action-btn.liked .action-icon {
            background: rgba(232,67,147,0.25);
            border-color: var(--accent-pink);
            color: var(--accent-pink);
        }
        .short-action-btn.disliked .action-icon {
            background: rgba(108,92,231,0.2);
            border-color: var(--accent-purple);
            color: var(--accent-purple);
        }

        /* Animation pop */
        @keyframes pop {
            0%   { transform: scale(1); }
            40%  { transform: scale(1.25); }
            100% { transform: scale(1); }
        }
        .short-action-btn.pop { animation: pop 0.25s ease-out; }

        /* ─── Panel commentaires ─── */
        .comments-panel {
            position: fixed;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%) translateY(100%);
            width: min(480px, 100vw);
            max-height: 90dvh;
            background: rgba(13, 13, 25, 0.97);
            backdrop-filter: blur(20px);
            border-radius: 20px 20px 0 0;
            border: 1px solid rgba(255,255,255,0.08);
            border-bottom: none;
            z-index: 100;
            display: flex;
            flex-direction: column;
            transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .comments-panel.open {
            transform: translateX(-50%) translateY(0);
        }
        .comments-panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 20px 12px;
            border-bottom: 1px solid rgba(255,255,255,0.07);
            flex-shrink: 0;
        }
        .comments-panel-header h3 {
            font-family: 'Syne', sans-serif;
            font-size: 0.95rem;
            font-weight: 800;
        }
        .comments-close-btn {
            background: transparent;
            border: 1px solid rgba(255,255,255,0.1);
            color: rgba(255,255,255,0.6);
            width: 28px;
            height: 28px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            transition: all 0.2s;
        }
        .comments-close-btn:hover { background: rgba(255,255,255,0.1); color: #fff; }

        .comments-list {
            flex: 1;
            overflow-y: auto;
            padding: 12px 20px;
            scrollbar-width: thin;
            scrollbar-color: var(--accent-purple) transparent;
        }

        .comment-item {
            display: flex;
            gap: 10px;
            margin-bottom: 16px;
        }
        .comment-item img {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
        }
        .comment-body { flex: 1; }
        .comment-author {
            font-size: 0.78rem;
            font-weight: 700;
            margin-bottom: 3px;
        }
        .comment-text {
            font-size: 0.85rem;
            opacity: 0.85;
            line-height: 1.4;
            margin-bottom: 6px;
        }
        .comment-actions {
            display: flex;
            gap: 12px;
        }
        .btn-comment-action {
            background: transparent;
            border: none;
            color: rgba(255,255,255,0.45);
            padding: 3px 8px;
            border-radius: 20px;
            font-size: 0.78rem;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            transition: all 0.2s;
        }
        .btn-comment-action:hover { background: rgba(255,255,255,0.07); color: #fff; }
        .btn-like-comment.active { color: #a29bfe; background: rgba(108,92,231,0.15); }
        .btn-dislike-comment.active { color: #fd79a8; background: rgba(253,121,168,0.1); }

        /* Input commentaire */
        .comments-input-wrap {
            display: flex;
            gap: 10px;
            align-items: center;
            padding: 55px 20px;
            border-top: 1px solid rgba(255,255,255,0.07);
            flex-shrink: 0;
        }
        .comments-input-wrap img {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
        }
        .comment-input {
            flex: 1;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 20px;
            color: #fff;
            padding: 8px 14px;
            font-size: 0.85rem;
            font-family: 'DM Sans', sans-serif;
            outline: none;
            transition: border-color 0.2s;
        }
        .comment-input:focus { border-color: var(--accent-purple); }
        .comment-input::placeholder { color: rgba(255,255,255,0.3); }
        .btn-send-comment {
            background: var(--accent-purple);
            border: none;
            color: #fff;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            transition: background 0.2s, transform 0.15s;
            flex-shrink: 0;
        }
        .btn-send-comment:hover { background: #a29bfe; transform: scale(1.1); }

        /* Publish btn */
        .publish-btn {
            margin-top: 12px;
            background: linear-gradient(135deg, var(--accent-purple), var(--accent-pink));
            border: none;
            border-radius: 50px;
            color: #fff;
            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 0.75rem;
            padding: 10px 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
            transition: transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 4px 20px rgba(108,92,231,0.35);
        }
        .publish-btn:hover { transform: scale(1.05); box-shadow: 0 6px 28px rgba(108,92,231,0.5); }

        @media (max-width: 520px) {
            .short-actions { display: none; }
            .shorts-layout { padding: 0; }
            .short-wrapper { height: 100dvh; border-radius: 0; aspect-ratio: unset; width: 100%; }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="shorts-layout">

        {# ── Lecteur vertical ── #}
        <div class="short-wrapper" id="short-container">
            <video
                id="starduste-short"
                class="video-js vjs-fluid"
                preload="auto"
                playsinline
                loop
                poster="{{ short.thumbnailUrl ?? 'https://via.placeholder.com/405x720/0a0a0f/6c5ce7?text=Short' }}">
                <source src="{{ asset(short.VideoUrl) }}">
            </video>

            <div class="short-overlay"></div>
            <div class="short-timer" id="short-timer">0:00 / 0:00</div>

            <div class="short-play-btn" id="short-play-btn">
                <i class="bi bi-play-fill" id="short-play-icon"></i>
            </div>

            <div class="short-progress" id="short-progress">
                <div class="short-progress-fill" id="short-progress-fill"></div>
                <div class="short-progress-thumb" id="short-progress-thumb"></div>
            </div>

            <div class="short-info">
                <div class="short-badge">Short</div>
                <div class="short-title">{{ short.title }}</div>
                <div class="short-meta">
                    <i class="bi bi-eye-fill"></i> {{ short.views ?? 0 }} vues
                    <span>•</span>
                    <i class="bi bi-calendar3"></i> {{ "now"|date("d M. Y") }}
                </div>
            </div>
        </div>

        {# ── Actions droite ── #}
        <div class="short-actions">
            <button class="short-action-btn" id="btn-like" data-videoid="{{ short.id }}" title="J'aime">
                <div class="action-icon"><i class="bi bi-heart-fill"></i></div>
                <span id="like-count">{{ short.likevid ?? 0 }}</span>
            </button>

            <button class="short-action-btn" id="btn-dislike" data-videoid="{{ short.id }}" title="Je n'aime pas">
                <div class="action-icon"><i class="bi bi-hand-thumbs-down"></i></div>
                <span id="dislike-count">{{ short.dislikevid ?? 0 }}</span>
            </button>

            <button class="short-action-btn" id="btn-comments" title="Commentaires">
                <div class="action-icon"><i class="bi bi-chat-fill"></i></div>
                <span>{{ Commentaires|length }}</span>
            </button>

            <button class="short-action-btn" title="Partager">
                <div class="action-icon"><i class="bi bi-share-fill"></i></div>
                <span>Partager</span>
            </button>

            <button class="short-action-btn" title="Vitesse de lecture" id="btn-speed">
                <div class="action-icon"><i class="bi bi-speedometer2"></i></div>
                <span id="speed-label">1×</span>
            </button>

            <button class="publish-btn">
                <i class="bi bi-rocket-takeoff-fill"></i>
                Publier
            </button>
        </div>

    </div>

    {# ── Panel commentaires ── #}
    <div class="comments-panel" id="comments-panel">
        <div class="comments-panel-header">
            <h3>Commentaires</h3>
            <button class="comments-close-btn" id="comments-close">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="comments-list" id="comments-list">
            {% for Commentaire in Commentaires %}
                <div class="comment-item" data-commentid="{{ Commentaire.id }}">
                    <img src="{{ asset(Commentaire.uploaderpfp) }}" alt="avatar">
                    <div class="comment-body">
                        <div class="comment-author">{{ Commentaire.uploaderUsername }}</div>
                        <div class="comment-text">{{ Commentaire.ComText }}</div>
                        <div class="comment-actions">
                            <button class="btn-comment-action btn-like-comment" data-commentid="{{ Commentaire.id }}">
                                <i class="bi bi-hand-thumbs-up"></i>
                                <span class="like-count">{{ Commentaire.Likes }}</span>
                            </button>
                            <button class="btn-comment-action btn-dislike-comment" data-commentid="{{ Commentaire.id }}">
                                <i class="bi bi-hand-thumbs-down"></i>
                                <span class="dislike-count">{{ Commentaire.Dislikes }}</span>
                            </button>
                            <span style="font-size:0.75rem;color:rgba(255,255,255,0.4);cursor:pointer">Répondre</span>
                        </div>
                    </div>
                </div>
            {% else %}
                <p style="text-align:center;color:rgba(255,255,255,0.3);font-size:0.85rem;padding:20px 0">
                    Aucun commentaire pour l'instant
                </p>
            {% endfor %}
        </div>

        <div class="comments-input-wrap">
            <img src="{{ app.user and app.user.pfppath ? asset(app.user.pfppath) : asset('uploads/fallbacksElement/FallbackPFP.png') }}" alt="avatar">
            <input type="text" class="comment-input" id="comment-input-short" placeholder="Ajouter un commentaire…">
            <button class="btn-send-comment" id="btn-send-comment">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            /* ── Init VideoJS ── */
            const player = videojs('starduste-short', {
                controls: false,
                autoplay: true,
                muted: false,
                loop: true,
            });

            const playBtn    = document.getElementById('short-play-btn');
            const playIcon   = document.getElementById('short-play-icon');
            const fill       = document.getElementById('short-progress-fill');
            const thumb      = document.getElementById('short-progress-thumb');
            const progressEl = document.getElementById('short-progress');
            const timerEl    = document.getElementById('short-timer');
            let hideTimer;

            const fmt = s => {
                const m = Math.floor(s / 60);
                const sec = Math.floor(s % 60).toString().padStart(2, '0');
                return `${m}:${sec}`;
            };

            document.getElementById('short-container').addEventListener('click', function (e) {
                if (e.target.closest('.short-progress') || e.target.closest('.short-actions')) return;
                player.paused() ? player.play() : player.pause();
            });

            player.on('play', () => { playIcon.className = 'bi bi-pause-fill'; showPlayBtn(); });
            player.on('pause', () => { playIcon.className = 'bi bi-play-fill'; showPlayBtn(true); });

            function showPlayBtn(stay = false) {
                playBtn.classList.add('visible');
                clearTimeout(hideTimer);
                if (!stay) hideTimer = setTimeout(() => playBtn.classList.remove('visible'), 900);
            }

            player.on('timeupdate', () => {
                const pct = player.duration() ? (player.currentTime() / player.duration()) * 100 : 0;
                fill.style.height  = pct + '%';
                thumb.style.bottom = pct + '%';
                timerEl.textContent = fmt(player.currentTime()) + ' / ' + fmt(player.duration() || 0);
            });

            progressEl.addEventListener('click', function (e) {
                const rect = progressEl.getBoundingClientRect();
                const ratio = 1 - (e.clientY - rect.top) / rect.height;
                player.currentTime(ratio * player.duration());
            });

            /* ── Vitesse ── */
            const speeds = [0.5, 1, 1.5, 2];
            let speedIdx = 1;
            document.getElementById('btn-speed').addEventListener('click', function () {
                speedIdx = (speedIdx + 1) % speeds.length;
                player.playbackRate(speeds[speedIdx]);
                document.getElementById('speed-label').textContent = speeds[speedIdx] + '×';
            });

            player.ready(() => console.log('Starduste Short — prêt !'));

            /* ────────────────────────────────────────
               LIKES / DISLIKES VIDÉO
            ──────────────────────────────────────── */
            const btnLike     = document.getElementById('btn-like');
            const btnDislike  = document.getElementById('btn-dislike');
            const nombrelike  = document.getElementById('like-count');
            const nombredislike = document.getElementById('dislike-count');

            function triggerPop(btn) {
                btn.classList.remove('pop');
                void btn.offsetWidth;
                btn.classList.add('pop');
                btn.addEventListener('animationend', () => btn.classList.remove('pop'), { once: true });
            }

            /* Vérifier l'état initial like/dislike */
            (async () => {
                const idvideo = btnLike.dataset.videoid;
                try {
                    const response = await fetch('/checklike', {
                        method: 'POST',
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ idvideo })
                    });
                    const data = await response.json();
                    if (data.action === "Liked")    btnLike.classList.add('liked');
                    if (data.action === "Disliked") btnDislike.classList.add('disliked');
                } catch (error) { console.error(error); }
            })();

            btnLike.addEventListener('click', async function () {
                const idVideo = this.dataset.videoid;
                try {
                    const response = await fetch("/addvideolike", {
                        method: 'POST',
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ idVideo })
                    });
                    const data = await response.json();
                    if (response.ok) {
                        if (data.action === "Liked") {
                            this.classList.add('liked');
                            triggerPop(this);
                            if (btnDislike.classList.contains('disliked')) {
                                btnDislike.classList.remove('disliked');
                                nombredislike.textContent = data.nombredislike;
                            }
                            nombrelike.textContent = data.nombrelike;
                        } else if (data.action === "unliked") {
                            this.classList.remove('liked');
                            triggerPop(this);
                            nombrelike.textContent = data.nombrelike;
                        }
                    }
                } catch (error) { console.error(error); }
            });

            btnDislike.addEventListener('click', async function () {
                const idVideo = btnLike.dataset.videoid;
                try {
                    const response = await fetch("/addvideodislike", {
                        method: 'POST',
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ idVideo })
                    });
                    const data = await response.json();
                    if (response.ok) {
                        if (data.action === "Disliked") {
                            this.classList.add('disliked');
                            if (btnLike.classList.contains('liked')) {
                                btnLike.classList.remove('liked');
                                nombrelike.textContent = data.nombrelike;
                            }
                            triggerPop(this);
                            nombredislike.textContent = data.nombredislike;
                        } else if (data.action === "undisliked") {
                            this.classList.remove('disliked');
                            triggerPop(this);
                            nombredislike.textContent = data.nombredislike;
                        }
                    }
                } catch (error) { console.error(error); }
            });

            /* ────────────────────────────────────────
               PANEL COMMENTAIRES
            ──────────────────────────────────────── */
            const commentsPanel = document.getElementById('comments-panel');

            document.getElementById('btn-comments').addEventListener('click', () => {
                commentsPanel.classList.add('open');
            });
            document.getElementById('comments-close').addEventListener('click', () => {
                commentsPanel.classList.remove('open');
            });

            /* Vérifier l'état initial des likes de commentaires */
            (async () => {
                const commentIds = [...document.querySelectorAll('.comment-item')]
                    .map(div => div.dataset.commentid);
                if (commentIds.length === 0) return;
                try {
                    const response = await fetch('/checkcommentlikes', {
                        method: 'POST',
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ commentIds })
                    });
                    const data = await response.json();
                    data.liked.forEach(id => {
                        const btn = document.querySelector(`.btn-like-comment[data-commentid="${id}"]`);
                        if (btn) btn.classList.add('active');
                    });
                    data.disliked.forEach(id => {
                        const btn = document.querySelector(`.btn-dislike-comment[data-commentid="${id}"]`);
                        if (btn) btn.classList.add('active');
                    });
                } catch (error) { console.error(error); }
            })();

            /* Envoyer un commentaire */
            document.getElementById('btn-send-comment').addEventListener('click', async function () {
                const input = document.getElementById('comment-input-short');
                const message = input.value.trim();
                if (!message) return;

                const idvideo = btnLike.dataset.videoid;
                try {
                    const response = await fetch("/commentupload", {
                        method: 'POST',
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ message, uuidvideo: idvideo })
                    });
                    const data = await response.json();
                    if (response.ok) {
                        input.value = '';
                        // Ajouter le commentaire dans la liste sans rechargement
                        const list = document.getElementById('comments-list');
                        const div = document.createElement('div');
                        div.className = 'comment-item';
                        div.dataset.commentid = data.id ?? '';
                        div.innerHTML = `
                            <img src="{{ app.user and app.user.pfppath ? asset(app.user.pfppath) : asset('uploads/fallbacksElement/FallbackPFP.png') }}" alt="avatar">
                            <div class="comment-body">
                                <div class="comment-author">{{ app.user ? app.user.pseudo : 'Invité' }}</div>
                                <div class="comment-text">${message}</div>
                                <div class="comment-actions">
                                    <button class="btn-comment-action btn-like-comment" data-commentid="${data.id ?? ''}">
                                        <i class="bi bi-hand-thumbs-up"></i>
                                        <span class="like-count">0</span>
                                    </button>
                                    <button class="btn-comment-action btn-dislike-comment" data-commentid="${data.id ?? ''}">
                                        <i class="bi bi-hand-thumbs-down"></i>
                                        <span class="dislike-count">0</span>
                                    </button>
                                </div>
                            </div>`;
                        list.prepend(div);
                        attachCommentListeners(div);
                    }
                } catch (error) { console.error(error); }
            });

            /* Like/dislike commentaires */
            function attachCommentListeners(container) {
                container.querySelectorAll('.btn-like-comment').forEach(btn => {
                    btn.addEventListener('click', async function () {
                        const idCommentary = this.dataset.commentid;
                        const commentDiv = this.closest('.comment-item');
                        const likecount = commentDiv.querySelector('.like-count');
                        const dislikecount = commentDiv.querySelector('.dislike-count');
                        const btndislike = commentDiv.querySelector('.btn-dislike-comment');
                        const idvideo = btnLike.dataset.videoid;

                        try {
                            const response = await fetch("/addcommentarylike", {
                                method: 'POST',
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({ idVideo: idvideo, idcommentaire: idCommentary })
                            });
                            const data = await response.json();
                            if (response.ok) {
                                if (data.action === "Liked") {
                                    this.classList.add('active');
                                    triggerPop(this);
                                    if (btndislike.classList.contains('active')) {
                                        console.log("retiré l'actif du bouton dislike comment")
                                        btndislike.classList.remove('active');
                                        dislikecount.textContent = data.nombredislike;
                                    }
                                    likecount.textContent = data.nombrelike;
                                } else if (data.action === "unliked") {
                                    this.classList.remove('active');
                                    triggerPop(this);
                                    likecount.textContent = data.nombrelike;
                                }
                            }
                        } catch (error) { console.error(error); }
                    });
                });

                container.querySelectorAll('.btn-dislike-comment').forEach(btn => {
                    btn.addEventListener('click', async function () {
                        const idCommentary = this.dataset.commentid;
                        const commentDiv = this.closest('.comment-item');
                        const likecount = commentDiv.querySelector('.like-count');
                        const dislikecount = commentDiv.querySelector('.dislike-count');
                        const btnlike = commentDiv.querySelector('.btn-like-comment');
                        const idvideo = btnLike.dataset.videoid;

                        try {
                            const response = await fetch("/addcommentarydislike", {
                                method: 'POST',
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({ idVideo: idvideo, idcommentaire: idCommentary })
                            });
                            const data = await response.json();
                            if (response.ok) {
                                if (data.action === "Disliked") {
                                    this.classList.add('active');
                                    if (btnlike.classList.contains('active')) {
                                        btnlike.classList.remove('active');
                                        likecount.textContent = data.nombrelike;
                                    }
                                    triggerPop(this);
                                    dislikecount.textContent = data.nombredislike;
                                } else if (data.action === "undisliked") {
                                    this.classList.remove('active');
                                    triggerPop(this);
                                    dislikecount.textContent = data.nombredislike;
                                }
                            }
                        } catch (error) { console.error(error); }
                    });
                });
            }

            /* Attacher les listeners aux commentaires existants */
            document.querySelectorAll('.comment-item').forEach(item => attachCommentListeners(item));

        });
    </script>
{% endblock %}
