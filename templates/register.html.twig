{% block register %}
     {{ form_start(registerform, {attr: {id: 'registerform'}}) }}
     {{ form_row(registerform.Pseudo) }}
     {{ form_row(registerform.AGE) }}
     {{ form_row(registerform.EMAIL) }}
     {{ form_row(registerform.PASSWORD) }}
     <button type="submit">Enregistrer</button>
     {{ form_end(registerform) }}

     <p id="error"></p>
    <script>
        document.getElementById("registerform").addEventListener("submit", async function(e) {

            e.preventDefault(); // empêche le rechargement de la page
            const form = document.getElementById("registerform");

            const response = await fetch("/api/register", {
                method: "POST",
                body: new URLSearchParams(new FormData(form)),
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                }
            });

            const data = await response.json();

            if(response.ok){
                alert("test terminé avec succes")
            } else {
                document.getElementById("error").innerText = data.message || "Une erreur est survenue";
            }

        });
    </script>


{% endblock %}
