<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Starduste — Partage ta lumière</title>
    <meta name="description" content="Starduste est la plateforme vidéo nouvelle génération. Découvrez, partagez et créez du contenu exceptionnel.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --bg-primary: #0a0a0f;
            --bg-secondary: #0f0f1a;
            --bg-card: #13131f;
            --bg-hover: #1a1a2e;
            --bg-input: #16162a;
            --accent: #7c6af7;
            --accent-2: #f97066;
            --accent-3: #34d399;
            --accent-live: #ff4444;
            --accent-short: #f97066;
            --accent-video: #7c6af7;
            --accent-glow: rgba(124, 106, 247, 0.35);
            --live-glow: rgba(255, 68, 68, 0.3);
            --short-glow: rgba(249, 112, 102, 0.3);
            --text-primary: #f0f0ff;
            --text-secondary: #8888aa;
            --text-muted: #555570;
            --border: rgba(124, 106, 247, 0.15);
            --border-subtle: rgba(255,255,255,0.06);
            --sidebar-w: 240px;
            --nav-h: 64px;
            --radius: 12px;
            --radius-sm: 8px;
            --transition: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            --shadow-card: 0 4px 24px rgba(0,0,0,0.4);
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body { font-family: 'DM Sans', sans-serif; background: var(--bg-primary); color: var(--text-primary); min-height: 100vh; overflow-x: hidden; }

        body::before {
            content: ''; position: fixed; inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 9999; opacity: 0.3;
        }
        body::after {
            content: ''; position: fixed; top: -30vh; left: -20vw; width: 80vw; height: 80vh;
            background: radial-gradient(ellipse, rgba(124,106,247,0.08) 0%, transparent 70%);
            pointer-events: none; z-index: 0;
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--text-muted); border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--accent); }

        h1, h2, h3, h4, h5 { font-family: 'Syne', sans-serif; }

        /* ===== PAGE PROGRESS ===== */
        .page-progress { position: fixed; top: 0; left: 0; height: 2px; background: linear-gradient(90deg, var(--accent), var(--accent-2)); width: 0%; z-index: 9999; transition: width 0.2s ease; }

        /* ===== NAVBAR ===== */
        .navbar { position: fixed; top: 0; left: 0; right: 0; height: var(--nav-h); background: rgba(10,10,15,0.85); backdrop-filter: blur(20px) saturate(1.5); border-bottom: 1px solid var(--border-subtle); z-index: 1000; display: flex; align-items: center; padding: 0 20px; gap: 16px; transition: background var(--transition); }
        .navbar.scrolled { background: rgba(10,10,15,0.97); border-bottom-color: var(--border); }
        .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; flex-shrink: 0; }
        .logo-mark { width: 36px; height: 36px; }
        .logo-mark svg { width: 36px; height: 36px; }
        .logo-text { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1.4rem; background: linear-gradient(135deg, #fff 0%, var(--accent) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; letter-spacing: -0.03em; }
        .search-wrapper { flex: 1; max-width: 680px; margin: 0 auto; position: relative; }
        .search-inner { display: flex; align-items: center; background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: 100px; overflow: hidden; transition: border-color var(--transition), box-shadow var(--transition); }
        .search-inner:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); }
        .search-input { flex: 1; background: transparent; border: none; outline: none; padding: 10px 20px; color: var(--text-primary); font-family: 'DM Sans', sans-serif; font-size: 0.9rem; }
        .search-input::placeholder { color: var(--text-muted); }
        .search-btn { background: var(--bg-hover); border: none; border-left: 1px solid var(--border-subtle); color: var(--text-secondary); padding: 0 18px; height: 44px; cursor: pointer; transition: color var(--transition), background var(--transition); display: flex; align-items: center; }
        .search-btn:hover { background: var(--accent); color: #fff; }
        .search-suggestions { position: absolute; top: calc(100% + 8px); left: 0; right: 0; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; display: none; z-index: 100; box-shadow: var(--shadow-card); }
        .search-suggestions.active { display: block; }
        .suggestion-item { display: flex; align-items: center; gap: 12px; padding: 10px 16px; color: var(--text-secondary); cursor: pointer; transition: background var(--transition); font-size: 0.9rem; }
        .suggestion-item:hover { background: var(--bg-hover); color: var(--text-primary); }
        .nav-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
        .nav-btn { background: transparent; border: 1px solid var(--border-subtle); color: var(--text-secondary); border-radius: 100px; padding: 8px 16px; cursor: pointer; font-family: 'DM Sans', sans-serif; font-size: 0.85rem; font-weight: 500; transition: all var(--transition); display: flex; align-items: center; gap: 6px; white-space: nowrap; }
        .nav-btn:hover { border-color: var(--accent); color: var(--accent); }
        .nav-btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
        .nav-btn-primary:hover { background: #6b59e8; border-color: #6b59e8; color: #fff; box-shadow: 0 4px 16px var(--accent-glow); }
        .nav-icon-btn { background: transparent; border: 1px solid var(--border-subtle); color: var(--text-secondary); width: 40px; height: 40px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all var(--transition); position: relative; }
        .nav-icon-btn:hover { border-color: var(--accent); color: var(--accent); }
        .badge-dot { position: absolute; top: 6px; right: 6px; width: 8px; height: 8px; background: var(--accent-2); border-radius: 50%; border: 2px solid var(--bg-primary); }
        .nav-avatar { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 2px solid var(--border); display: block; }
        .mobile-menu-btn { display: none; background: transparent; border: none; color: var(--text-primary); font-size: 1.3rem; cursor: pointer; padding: 4px; }
        .sidebar-toggle { background: transparent; border: none; color: var(--text-secondary); font-size: 1.2rem; cursor: pointer; padding: 8px; border-radius: var(--radius-sm); transition: color var(--transition), background var(--transition); flex-shrink: 0; }
        .sidebar-toggle:hover { background: var(--bg-hover); color: var(--text-primary); }

        /* ===== SIDEBAR ===== */
        .sidebar { position: fixed; top: var(--nav-h); left: 0; width: var(--sidebar-w); height: calc(100vh - var(--nav-h)); background: var(--bg-secondary); border-right: 1px solid var(--border-subtle); overflow-y: auto; overflow-x: hidden; z-index: 900; padding: 16px 0; transition: transform 0.3s cubic-bezier(0.4,0,0.2,1), width 0.3s cubic-bezier(0.4,0,0.2,1); }
        .sidebar.collapsed { width: 64px; }
        .sidebar.collapsed .nav-label, .sidebar.collapsed .sidebar-section-title { display: none; }
        .sidebar.collapsed .sidebar-item { justify-content: center; padding: 10px; }
        .sidebar-section { padding: 8px 0; }
        .sidebar-section + .sidebar-section { border-top: 1px solid var(--border-subtle); }
        .sidebar-section-title { padding: 8px 16px 4px; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
        .sidebar-item { display: flex; align-items: center; gap: 12px; padding: 10px 16px; color: var(--text-secondary); cursor: pointer; transition: background var(--transition), color var(--transition); font-size: 0.9rem; position: relative; text-decoration: none; }
        .sidebar-item:hover { background: var(--bg-hover); color: var(--text-primary); }
        .sidebar-item.active { background: var(--bg-hover); color: var(--accent); }
        .sidebar-item.active::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--accent); border-radius: 0 4px 4px 0; }
        .sidebar-item i { font-size: 1.1rem; flex-shrink: 0; }
        .nav-label { font-size: 0.88rem; }

        /* ===== MAIN CONTENT ===== */
        .main-content { margin-left: var(--sidebar-w); margin-top: var(--nav-h); padding: 24px 28px; min-height: calc(100vh - var(--nav-h)); transition: margin-left 0.3s cubic-bezier(0.4,0,0.2,1); position: relative; z-index: 1; }
        .main-content.sidebar-collapsed { margin-left: 64px; }

        /* ===== BANDEAUX ===== */
        .bandeau {
            margin-bottom: 28px;
            background: var(--bg-card);
            border-radius: 20px;
            border: 1px solid var(--border-subtle);
            overflow: hidden;
        }
        .bandeau-header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 20px 24px 0;
        }
        .bandeau-body { padding: 16px 24px 22px; }

        /* Couleurs par type */
        .bandeau-live { border-color: rgba(255,68,68,0.25); }
        .bandeau-live .bandeau-header { background: linear-gradient(90deg, rgba(255,68,68,0.07) 0%, transparent 55%); }
        .accent-live { background: var(--accent-live) !important; box-shadow: 0 0 14px var(--live-glow); }

        .bandeau-shorts { border-color: rgba(249,112,102,0.25); }
        .bandeau-shorts .bandeau-header { background: linear-gradient(90deg, rgba(249,112,102,0.07) 0%, transparent 55%); }
        .accent-short { background: var(--accent-short) !important; box-shadow: 0 0 14px var(--short-glow); }

        .bandeau-videos { border-color: rgba(124,106,247,0.25); }
        .bandeau-videos .bandeau-header { background: linear-gradient(90deg, rgba(124,106,247,0.07) 0%, transparent 55%); }

        .section-title { font-family: 'Syne', sans-serif; font-size: 1.15rem; font-weight: 700; display: flex; align-items: center; gap: 10px; }
        .section-title-accent { width: 4px; height: 20px; background: var(--accent); border-radius: 2px; flex-shrink: 0; }
        .section-link { font-size: 0.83rem; font-weight: 500; text-decoration: none; display: flex; align-items: center; gap: 4px; transition: gap var(--transition); white-space: nowrap; }
        .section-link:hover { gap: 8px; }
        .link-live { color: var(--accent-live); }
        .link-short { color: var(--accent-short); }
        .link-video { color: var(--accent-video); }

        /* ===== BADGE LIVE ===== */
        .live-badge { display: inline-flex; align-items: center; gap: 5px; background: var(--accent-live); color: #fff; font-size: 0.7rem; font-weight: 700; padding: 3px 9px; border-radius: 100px; letter-spacing: 0.06em; text-transform: uppercase; }
        .live-dot { width: 6px; height: 6px; border-radius: 50%; background: #fff; animation: livePulse 1.2s ease-in-out infinite; }
        @keyframes livePulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.3; transform: scale(0.6); } }

        /* ===== SCROLL WRAP ===== */
        .h-scroll-wrap { position: relative; }
        .scroll-btn { position: absolute; top: 40%; transform: translateY(-50%); width: 36px; height: 36px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 50%; color: var(--text-primary); cursor: pointer; display: flex; align-items: center; justify-content: center; z-index: 10; transition: all var(--transition); box-shadow: var(--shadow-card); }
        .scroll-btn:hover { background: var(--accent); border-color: var(--accent); }
        .scroll-btn-prev { left: -18px; }
        .scroll-btn-next { right: -18px; }

        /* ===== LIVE CARDS ===== */
        .live-track { display: flex; gap: 16px; overflow-x: auto; padding-bottom: 6px; scrollbar-width: none; scroll-snap-type: x mandatory; }
        .live-track::-webkit-scrollbar { display: none; }
        .live-card { flex-shrink: 0; width: 300px; scroll-snap-align: start; background: var(--bg-hover); border-radius: var(--radius); border: 1px solid rgba(255,68,68,0.12); overflow: hidden; cursor: pointer; transition: transform var(--transition), border-color var(--transition); text-decoration: none; color: inherit; display: block; }
        .live-card:hover { transform: translateY(-3px); border-color: rgba(255,68,68,0.45); }
        .live-thumb { position: relative; aspect-ratio: 16/9; overflow: hidden; background: #140808; }
        .live-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; }
        .live-card:hover .live-thumb img { transform: scale(1.05); }
        .live-thumb-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #1a0808, #0a0a1a); color: var(--text-muted); font-size: 2.2rem; }
        .live-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 55%); }
        .live-badge-pos { position: absolute; top: 10px; left: 10px; }
        .live-viewers-pos { position: absolute; bottom: 10px; left: 10px; font-size: 0.76rem; color: #fff; display: flex; align-items: center; gap: 4px; background: rgba(0,0,0,0.5); padding: 2px 8px; border-radius: 100px; }
        .live-info { padding: 11px 13px; display: flex; gap: 10px; align-items: flex-start; }
        .live-avatar { width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0; overflow: hidden; border: 2px solid var(--accent-live); background: linear-gradient(135deg, var(--accent-live), #ff8866); display: flex; align-items: center; justify-content: center; }
        .live-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .live-avatar i { color: #fff; font-size: 0.85rem; }
        .live-meta { flex: 1; min-width: 0; }
        .live-title { font-size: 0.86rem; font-weight: 600; color: var(--text-primary); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 2px; }
        .live-channel { font-size: 0.76rem; color: var(--text-secondary); }

        /* ===== SHORT CARDS ===== */
        .shorts-track { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 6px; scrollbar-width: none; scroll-snap-type: x mandatory; }
        .shorts-track::-webkit-scrollbar { display: none; }
        .short-card { flex-shrink: 0; width: 155px; scroll-snap-align: start; cursor: pointer; border-radius: var(--radius); overflow: hidden; background: var(--bg-hover); border: 1px solid var(--border-subtle); transition: transform var(--transition), border-color var(--transition); text-decoration: none; color: inherit; display: block; }
        .short-card:hover { transform: translateY(-4px); border-color: rgba(249,112,102,0.4); }
        .short-thumb { position: relative; aspect-ratio: 9/16; overflow: hidden; background: var(--bg-card); }
        .short-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; }
        .short-card:hover .short-thumb img { transform: scale(1.06); }
        .short-thumb-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: linear-gradient(180deg, #160a14, #0a0a1a); color: var(--text-muted); font-size: 2rem; }
        .short-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.7) 30%, transparent 70%); }
        .short-duration { position: absolute; bottom: 8px; left: 8px; font-size: 0.72rem; font-weight: 600; color: #fff; }
        .short-play { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%) scale(0.8); width: 38px; height: 38px; background: rgba(249,112,102,0.85); border-radius: 50%; display: flex; align-items: center; justify-content: center; opacity: 0; transition: all 0.25s cubic-bezier(0.34,1.56,0.64,1); }
        .short-card:hover .short-play { opacity: 1; transform: translate(-50%,-50%) scale(1); }
        .short-info { padding: 8px 10px 10px; }
        .short-title { font-size: 0.8rem; font-weight: 600; color: var(--text-primary); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .short-views { font-size: 0.72rem; color: var(--text-muted); margin-top: 3px; }

        /* ===== VIDEO GRID ===== */
        .video-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; }
        .video-card { cursor: pointer; border-radius: var(--radius); overflow: hidden; background: transparent; transition: transform var(--transition); animation: fadeIn 0.4s ease both; text-decoration: none; color: inherit; display: block; }
        .video-card:hover { transform: translateY(-4px); }
        .video-thumb { position: relative; border-radius: var(--radius); overflow: hidden; aspect-ratio: 16/9; background: var(--bg-hover); }
        .video-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; display: block; }
        .video-card:hover .video-thumb img { transform: scale(1.06); }
        .video-thumb-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, var(--bg-hover), var(--bg-card)); color: var(--text-muted); font-size: 2.5rem; }
        .video-duration { position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.85); color: #fff; font-size: 0.74rem; font-weight: 600; padding: 2px 7px; border-radius: 4px; }
        .video-preview { position: absolute; inset: 0; opacity: 0; transition: opacity 0.3s ease; background: rgba(0,0,0,0.25); display: flex; align-items: center; justify-content: center; }
        .video-card:hover .video-preview { opacity: 1; }
        .play-btn-overlay { width: 46px; height: 46px; background: rgba(124,106,247,0.9); border-radius: 50%; display: flex; align-items: center; justify-content: center; transform: scale(0.8); transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1); }
        .video-card:hover .play-btn-overlay { transform: scale(1); }
        .video-actions-overlay { position: absolute; top: 8px; right: 8px; display: flex; flex-direction: column; gap: 6px; opacity: 0; transform: translateX(8px); transition: all 0.2s ease; }
        .video-card:hover .video-actions-overlay { opacity: 1; transform: translateX(0); }
        .thumb-action-btn { width: 30px; height: 30px; background: rgba(10,10,15,0.85); border: none; border-radius: 50%; color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 0.78rem; transition: background var(--transition); backdrop-filter: blur(4px); }
        .thumb-action-btn:hover { background: var(--accent); }
        .video-info { padding: 11px 4px 0; display: flex; gap: 11px; }
        .video-avatar { width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0; overflow: hidden; background: linear-gradient(135deg, var(--accent), var(--accent-2)); }
        .video-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .video-meta { flex: 1; min-width: 0; }
        .video-title { font-size: 0.88rem; font-weight: 600; color: var(--text-primary); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 3px; transition: color var(--transition); }
        .video-card:hover .video-title { color: var(--accent); }
        .video-channel { font-size: 0.8rem; color: var(--text-secondary); }
        .video-stats { font-size: 0.76rem; color: var(--text-muted); margin-top: 2px; }

        /* ===== EMPTY STATE ===== */
        .empty-bandeau { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 44px 20px; gap: 10px; text-align: center; }
        .empty-icon { width: 62px; height: 62px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.7rem; margin-bottom: 6px; }
        .empty-icon-live { background: rgba(255,68,68,0.1); color: var(--accent-live); border: 1px solid rgba(255,68,68,0.2); }
        .empty-icon-short { background: rgba(249,112,102,0.1); color: var(--accent-short); border: 1px solid rgba(249,112,102,0.2); }
        .empty-icon-video { background: rgba(124,106,247,0.1); color: var(--accent-video); border: 1px solid rgba(124,106,247,0.2); }
        .empty-bandeau h4 { font-size: 0.98rem; font-weight: 600; color: var(--text-secondary); font-family: 'Syne', sans-serif; margin: 0; }
        .empty-bandeau p { font-size: 0.82rem; color: var(--text-muted); max-width: 300px; line-height: 1.55; margin: 0; }

        /* ===== NOTIFICATIONS ===== */
        .notif-panel { position: fixed; top: calc(var(--nav-h) + 8px); right: 16px; width: 340px; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-card); z-index: 1100; transform: translateY(-8px); opacity: 0; pointer-events: none; transition: all 0.2s ease; overflow: hidden; }
        .notif-panel.active { transform: translateY(0); opacity: 1; pointer-events: all; }
        .notif-header { padding: 16px; border-bottom: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center; }
        .notif-title { font-weight: 600; font-size: 0.9rem; }
        .notif-clear { font-size: 0.8rem; color: var(--accent); cursor: pointer; }
        .notif-item { display: flex; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--border-subtle); cursor: pointer; transition: background var(--transition); }
        .notif-item:hover { background: var(--bg-hover); }
        .notif-item.unread { background: rgba(124,106,247,0.05); }
        .notif-avatar { width: 36px; height: 36px; border-radius: 50%; overflow: hidden; flex-shrink: 0; }
        .notif-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .notif-text { font-size: 0.82rem; color: var(--text-secondary); line-height: 1.4; }
        .notif-text strong { color: var(--text-primary); }
        .notif-time { font-size: 0.74rem; color: var(--text-muted); margin-top: 3px; }
        .notif-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex-shrink: 0; margin-top: 6px; }

        /* ===== TOAST ===== */
        .toast-container { position: fixed; bottom: 24px; right: 24px; z-index: 3000; display: flex; flex-direction: column; gap: 8px; }
        .toast { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 12px 16px; display: flex; align-items: center; gap: 10px; box-shadow: var(--shadow-card); animation: slideInRight 0.3s ease; font-size: 0.85rem; min-width: 240px; }
        .toast.success { border-color: rgba(52,211,153,0.4); }
        .toast.success i { color: var(--accent-3); }
        .toast.error { border-color: rgba(249,112,102,0.4); }
        .toast.error i { color: var(--accent-2); }
        .toast-exit { animation: slideOutRight 0.3s ease forwards; }

        /* ===== MODAL ===== */
        .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(8px); z-index: 2000; display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.2s ease; }
        .modal-overlay.active { opacity: 1; pointer-events: all; }
        .modal-box { background: var(--bg-card); border: 1px solid var(--border); border-radius: 20px; width: 100%; max-width: 440px; padding: 32px; transform: scale(0.95) translateY(20px); transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1); box-shadow: 0 24px 80px rgba(0,0,0,0.6); position: relative; }
        .modal-overlay.active .modal-box { transform: scale(1) translateY(0); }
        .modal-title { font-size: 1.4rem; font-weight: 800; margin-bottom: 6px; text-align: center; }
        .modal-sub { text-align: center; color: var(--text-secondary); font-size: 0.88rem; margin-bottom: 24px; }
        .form-group { margin-bottom: 16px; }
        .form-label { display: block; font-size: 0.82rem; font-weight: 500; color: var(--text-secondary); margin-bottom: 6px; }
        .form-control { width: 100%; background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 11px 14px; color: var(--text-primary); font-family: 'DM Sans', sans-serif; font-size: 0.9rem; outline: none; transition: border-color var(--transition), box-shadow var(--transition); }
        .form-control:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); }
        .btn-form { width: 100%; padding: 12px; background: var(--accent); color: #fff; border: none; border-radius: var(--radius-sm); font-family: 'DM Sans', sans-serif; font-size: 0.95rem; font-weight: 600; cursor: pointer; margin-top: 8px; transition: all var(--transition); }
        .btn-form:hover { background: #6b59e8; box-shadow: 0 8px 24px var(--accent-glow); }
        .modal-switch { text-align: center; margin-top: 16px; font-size: 0.85rem; color: var(--text-muted); }
        .modal-switch a { color: var(--accent); text-decoration: none; font-weight: 500; }
        .modal-close { position: absolute; top: 16px; right: 16px; background: transparent; border: none; color: var(--text-muted); font-size: 1.2rem; cursor: pointer; }
        .modal-close:hover { color: var(--text-primary); }

        /* ===== FOOTER ===== */
        .footer { border-top: 1px solid var(--border-subtle); padding: 32px 28px; margin-left: var(--sidebar-w); margin-top: 20px; }
        .footer-links { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-bottom: 16px; }
        .footer-link { color: var(--text-muted); font-size: 0.82rem; text-decoration: none; transition: color var(--transition); }
        .footer-link:hover { color: var(--text-secondary); }
        .footer-copy { font-size: 0.8rem; color: var(--text-muted); }
        .footer-copy span { color: var(--accent); }

        /* ===== ANIMATIONS ===== */
        @keyframes fadeIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes slideInRight { from { opacity: 0; transform: translateX(24px); } to { opacity: 1; transform: translateX(0); } }
        @keyframes slideOutRight { from { opacity: 1; transform: translateX(0); } to { opacity: 0; transform: translateX(24px); } }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 1100px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.mobile-open { transform: translateX(0); }
            .main-content, .footer { margin-left: 0; }
            .mobile-menu-btn { display: flex; }
        }
        @media (max-width: 768px) {
            .main-content { padding: 16px; }
            .nav-btn:not(.nav-btn-primary) { display: none; }
            .live-card { width: 260px; }
            .video-grid { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
        }
        @media (max-width: 480px) {
            .video-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
            .short-card { width: 130px; }
        }
    </style>
</head>
