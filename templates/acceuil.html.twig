<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>
    // ===== DATA =====
    const VIDEOS = [
        { id: 1, title: "Rust pour les débutants — De zéro à héros en 2h", channel: "CosmicDev", views: "1.2M", duration: "2:03:44", age: "3 jours", verified: true, seed: "v1", avatar: "a1" },
        { id: 2, title: "Créer un jeu 3D en une semaine avec Bevy Engine", channel: "NightCoder", views: "456K", duration: "47:22", age: "1 semaine", verified: false, seed: "v2", avatar: "a2" },
        { id: 3, title: "Le guide ultime de la cinématographie — Lumière et couleurs", channel: "ArtisanPixel", views: "2.8M", duration: "1:12:05", age: "2 semaines", verified: true, seed: "v3", avatar: "a3" },
        { id: 4, title: "Tokyo en 48h — Vlog immersif 4K", channel: "StellarDocs", views: "892K", duration: "23:15", age: "5 jours", verified: false, seed: "v4", avatar: "a4" },
        { id: 5, title: "Architecture microservices avec Docker et Kubernetes", channel: "DevOrbit", views: "334K", duration: "58:40", age: "2 jours", verified: true, seed: "v5", avatar: "a5" },
        { id: 6, title: "Composition musicale — De l'idée au morceau complet", channel: "SoundForge", views: "671K", duration: "1:28:33", age: "1 mois", verified: false, seed: "v6", avatar: "a6" %},
        { id: 7, title: "Intelligence artificielle en 2025 — Ce qui a vraiment changé", channel: "NebulaAI", views: "4.1M", duration: "35:08", age: "1 semaine", verified: true, seed: "v7", avatar: "a7" },
        { id: 8, title: "Design System complet — Figma to Code en temps réel", channel: "UXNova", views: "228K", duration: "1:45:20", age: "4 jours", verified: false, seed: "v8", avatar: "a8" },
    ];

    const TRENDING = [
        { rank: 1, title: "La course à l'espace en 2025 — SpaceX vs ESA", channel: "CosmosTV", views: "12M vues", duration: "28:41", seed: "t1" },
        { rank: 2, title: "Comment j'ai construit une startup en 30 jours avec Rust", channel: "FounderLog", views: "8.4M vues", duration: "54:12", seed: "t2" },
        { rank: 3, title: "Le piano à 440Hz vs 432Hz — Expérience ultime", channel: "SoundForge", views: "6.1M vues", duration: "18:33", seed: "t3" },
        { rank: 4, title: "J'ai voyagé dans 12 pays avec seulement 2000€", channel: "StellarDocs", views: "5.7M vues", duration: "41:05", seed: "t4" },
        { rank: 5, title: "Photographie nocturne — Technique pro accessible", channel: "ArtisanPixel", views: "3.9M vues", duration: "32:18", seed: "t5" },
    ];

    const CHANNELS = [
        { name: "CosmicDev", subs: "245K", verified: true, seed: "ch1" },
        { name: "NightCoder", subs: "89K", verified: false, seed: "ch2" },
        { name: "ArtisanPixel", subs: "1.2M", verified: true, seed: "ch3" },
        { name: "StellarDocs", subs: "34K", verified: false, seed: "ch4" },
        { name: "NebulaAI", subs: "560K", verified: true, seed: "ch5" },
        { name: "DevOrbit", subs: "112K", verified: false, seed: "ch6" },
        { name: "SoundForge", subs: "78K", verified: false, seed: "ch7" },
        { name: "UXNova", subs: "43K", verified: true, seed: "ch8" },
    ];

    // ===== RENDER FUNCTIONS =====
    function renderVideoCard(v, idx) {
        return `
    <div class="video-card" onclick="playVideo(${v.id})" style="animation-delay:${idx * 0.05}s">
      <div class="video-thumb">
        <img src="https://picsum.photos/seed/${v.seed}/640/360" alt="${v.title}" loading="lazy">
        <div class="video-preview">
          <div class="play-btn-overlay"><i class="bi bi-play-fill text-white fs-5"></i></div>
        </div>
        <span class="video-duration">${v.duration}</span>
        <div class="video-actions-overlay">
          <button class="thumb-action-btn" onclick="event.stopPropagation(); showToast('Ajouté à regarder plus tard', 'success')" title="Regarder plus tard">
            <i class="bi bi-clock"></i>
          </button>
          <button class="thumb-action-btn" onclick="event.stopPropagation(); showToast('Ajouté à la file', 'success')" title="Ajouter à la file">
            <i class="bi bi-plus-lg"></i>
          </button>
          <button class="thumb-action-btn" onclick="event.stopPropagation()" title="Plus d'options">
            <i class="bi bi-three-dots-vertical"></i>
          </button>
        </div>
      </div>
      <div class="video-info">
        <div class="video-avatar"><img src="https://picsum.photos/seed/${v.avatar}/80/80" alt="${v.channel}" loading="lazy"></div>
        <div class="video-meta">
          <div class="video-title">${v.title}</div>
          <div class="video-channel">
            ${v.channel}
            ${v.verified ? '<i class="bi bi-patch-check-fill verified"></i>' : ''}
          </div>
          <div class="video-stats">${v.views} vues · ${v.age}</div>
        </div>
      </div>
    </div>
  `;
    }

    function renderTrendingCard(t, idx) {
        return `
    <div class="trending-card" onclick="playVideo(${t.rank})" style="animation-delay:${idx * 0.05}s">
      <div class="trending-rank">${String(t.rank).padStart(2, '0')}</div>
      <div class="trending-thumb">
        <img src="https://picsum.photos/seed/${t.seed}/336/189" alt="${t.title}" loading="lazy">
        <span class="video-duration" style="position:absolute;bottom:6px;right:6px">${t.duration}</span>
      </div>
      <div class="trending-info">
        <div class="trending-title">${t.title}</div>
        <div class="trending-channel">${t.channel}</div>
        <div class="trending-views"><i class="bi bi-eye"></i> ${t.views}</div>
      </div>
    </div>
  `;
    }

    function renderChannelCard(c) {
        return `
    <div class="h-scroll-card">
      <div class="channel-card">
        <div class="channel-card-avatar">
          <img src="https://picsum.photos/seed/${c.seed}/140/140" alt="${c.name}" loading="lazy">
        </div>
        <div class="channel-card-name">
          ${c.name}
          ${c.verified ? '<i class="bi bi-patch-check-fill" style="color:var(--accent);font-size:0.8rem"></i>' : ''}
        </div>
        <div class="channel-card-subs">${c.subs} abonnés</div>
        <button class="btn-subscribe" onclick="toggleSubscribe(this)">S'abonner</button>
      </div>
    </div>
  `;
    }

    // ===== INIT =====
    document.addEventListener('DOMContentLoaded', () => {
        document.getElementById('videoGrid').innerHTML = VIDEOS.map((v, i) => renderVideoCard(v, i)).join('');
        document.getElementById('newVideoGrid').innerHTML = [...VIDEOS].reverse().map((v, i) => renderVideoCard(v, i)).join('');
        document.getElementById('trendingList').innerHTML = TRENDING.map((t, i) => renderTrendingCard(t, i)).join('');
        document.getElementById('channelTrack').innerHTML = CHANNELS.map(c => renderChannelCard(c)).join('');

        // Scroll progress
        window.addEventListener('scroll', () => {
            const scrollPct = (window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100;
            document.getElementById('pageProgress').style.width = scrollPct + '%';

            // Navbar
            document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 10);
        });
    });

    // ===== SIDEBAR =====
    let sidebarCollapsed = false;
    function toggleSidebar() {
        sidebarCollapsed = !sidebarCollapsed;
        document.getElementById('sidebar').classList.toggle('collapsed', sidebarCollapsed);
        document.getElementById('mainContent').classList.toggle('sidebar-collapsed', sidebarCollapsed);
    }

    let mobileSidebarOpen = false;
    function toggleMobileSidebar() {
        mobileSidebarOpen = !mobileSidebarOpen;
        document.getElementById('sidebar').classList.toggle('mobile-open', mobileSidebarOpen);
    }

    // ===== SEARCH =====
    let searchTimeout;
    function handleSearch(val) {
        clearTimeout(searchTimeout);
        if (val.length > 1) {
            searchTimeout = setTimeout(() => {
                document.getElementById('searchSuggestions').classList.add('active');
            }, 200);
        } else {
            document.getElementById('searchSuggestions').classList.remove('active');
        }
    }

    function showSuggestions() {
        if (document.getElementById('searchInput').value.length > 1) {
            document.getElementById('searchSuggestions').classList.add('active');
        }
    }

    function hideSuggestions() {
        setTimeout(() => {
            document.getElementById('searchSuggestions').classList.remove('active');
        }, 200);
    }

    // ===== NOTIFICATIONS =====
    let notifOpen = false;
    function toggleNotifPanel() {
        notifOpen = !notifOpen;
        document.getElementById('notifPanel').classList.toggle('active', notifOpen);
    }

    function clearNotifications() {
        document.querySelectorAll('.notif-item.unread').forEach(el => {
            el.classList.remove('unread');
        });
        document.querySelector('.badge-dot').style.display = 'none';
        showToast('Toutes les notifications marquées comme lues', 'success');
    }

    document.addEventListener('click', (e) => {
        if (notifOpen && !e.target.closest('#notifPanel') && !e.target.closest('.nav-icon-btn')) {
            notifOpen = false;
            document.getElementById('notifPanel').classList.remove('active');
        }
    });

    // ===== CATEGORIES =====
    function filterCategory(el, cat) {
        document.querySelectorAll('.cat-pill').forEach(p => p.classList.remove('active'));
        el.classList.add('active');

        // Reload grid with animation
        const grid = document.getElementById('videoGrid');
        grid.style.opacity = '0';
        setTimeout(() => {
            grid.innerHTML = VIDEOS.map((v, i) => renderVideoCard(v, i)).join('');
            grid.style.opacity = '1';
        }, 200);
        grid.style.transition = 'opacity 0.2s ease';
    }

    // ===== VIDEO PLAY =====
    function playVideo(id) {
        window.location.href = `/watch/${id}`;
    }

    // ===== SUBSCRIBE =====
    function toggleSubscribe(btn) {
        const subscribed = btn.classList.toggle('subscribed');
        btn.textContent = subscribed ? '✓ Abonné' : "S'abonner";
        showToast(subscribed ? 'Abonnement confirmé !' : 'Désabonné', subscribed ? 'success' : 'error');
    }

    // ===== SCROLL TRACK =====
    function scrollTrack(id, dir) {
        const track = document.getElementById(id);
        track.scrollBy({ left: dir * 280, behavior: 'smooth' });
    }

    // ===== AUTH MODAL =====
    function openModal(type) {
        document.getElementById('authModal').classList.add('active');
        switchModal(type);
    }

    function closeModal() {
        document.getElementById('authModal').classList.remove('active');
    }

    function closeModalOnOverlay(e) {
        if (e.target === document.getElementById('authModal')) closeModal();
    }

    function switchModal(type) {
        document.getElementById('loginForm').style.display = type === 'login' ? 'block' : 'none';
        document.getElementById('registerForm').style.display = type === 'register' ? 'block' : 'none';
    }

    function handleLogin() {
        closeModal();
        showToast('Connexion réussie ! Bienvenue sur Starduste', 'success');
    }

    function handleRegister() {
        closeModal();
        showToast('Compte créé avec succès ! ✨ Bienvenue créateur !', 'success');
    }

    function headingconnexion(){
        window.location = "/login"
    }

    // ===== TOAST =====
    function showToast(msg, type = 'success') {
        const container = document.getElementById('toastContainer');
        const toast = document.createElement('div');
        toast.className = `toast ${type}`;
        toast.innerHTML = `
    <i class="bi ${type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill'}"></i>
    <span>${msg}</span>
  `;
        container.appendChild(toast);
        setTimeout(() => {
            toast.classList.add('toast-exit');
            setTimeout(() => toast.remove(), 300);
        }, 3000);
    }
</script>

</body>
</html>
