<!-- ========== MAIN ========== -->
<main class="main-content" id="mainContent">

    {# ============================================================ #}
    {# BANDEAU 1 — LIVES                                            #}
    {# Alimenté par $lives dans le controller (isLive = true)       #}
    {# ============================================================ #}
    <div class="bandeau bandeau-live">
        <div class="bandeau-header">
            <h2 class="section-title">
                <div class="section-title-accent accent-live"></div>
                <i class="bi bi-broadcast" style="color:var(--accent-live)"></i>
                En direct
                <span class="live-badge"><span class="live-dot"></span>LIVE</span>
            </h2>
            <a href="{{ path('app_lives') }}" class="section-link link-live">Tous les lives <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="bandeau-body">
            {% if lives is defined and lives|length > 0 %}
                <div class="h-scroll-wrap">
                    <button class="scroll-btn scroll-btn-prev" onclick="scrollTrack('liveTrack', -1)"><i class="bi bi-chevron-left"></i></button>
                    <div class="live-track" id="liveTrack">
                        {% for live in lives %}
                            <a href="{{ path('app_live_watch', {'slug': live.slug}) }}" class="live-card">
                                <div class="live-thumb">
                                    {% if live.thumbnailPath %}
                                        <img src="{{ live.thumbnailPath starts with 'http' ? live.thumbnailPath : asset(live.thumbnailPath) }}" alt="{{ live.title }}" loading="lazy">
                                    {% else %}
                                        <div class="live-thumb-placeholder"><i class="bi bi-broadcast"></i></div>
                                    {% endif %}
                                    <div class="live-overlay"></div>
                                    <div class="live-badge-pos"><span class="live-badge"><span class="live-dot"></span>LIVE</span></div>
                                    {% if live.viewers is defined and live.viewers %}
                                        <div class="live-viewers-pos"><i class="bi bi-eye-fill"></i> {{ live.viewers }}</div>
                                    {% endif %}
                                </div>
                                    <div class="live-info">
                                        <div class="live-avatar">
                                        {% if live.streamer and live.streamer.pfppath %}
                                            <img src="{{ asset(live.streamer.pfppath) }}" alt="">
                                        {% else %}
                                            <i class="bi bi-person-fill"></i>
                                        {% endif %}
                                        </div>
                                        <div class="live-meta">
                                            <div class="live-title">{{ live.title }}</div>
                                        <div class="live-channel">{{ live.streamer ? live.streamer.pseudo : 'Créateur' }}</div>
                                        {% if live.category %}
                                            <div class="live-channel">{{ live.category }}</div>
                                        {% endif %}
                                        </div>
                                    </div>
                            </a>
                        {% endfor %}
                    </div>
                    <button class="scroll-btn scroll-btn-next" onclick="scrollTrack('liveTrack', 1)"><i class="bi bi-chevron-right"></i></button>
                </div>
            {% else %}
                <div class="empty-bandeau">
                    <div class="empty-icon empty-icon-live"><i class="bi bi-broadcast"></i></div>
                    <h4>Aucun live en ce moment</h4>
                    <p>Personne n'est en direct pour l'instant. Revenez plus tard ou lancez votre propre live !</p>
                </div>
            {% endif %}
        </div>
    </div>

    {# ============================================================ #}
    {# BANDEAU 2 — SHORTS                                           #}
    {# Alimenté par $shorts dans le controller (isShort = true)     #}
    {# ============================================================ #}
    <div class="bandeau bandeau-shorts">
        <div class="bandeau-header">
            <h2 class="section-title">
                <div class="section-title-accent accent-short"></div>
                <i class="bi bi-phone" style="color:var(--accent-short)"></i>
                Shorts
            </h2>
            <a href="#" class="section-link link-short">Tous les shorts <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="bandeau-body">
            {% if shorts is defined and shorts|length > 0 %}
                <div class="h-scroll-wrap">
                    <button class="scroll-btn scroll-btn-prev" onclick="scrollTrack('shortsTrack', -1)"><i class="bi bi-chevron-left"></i></button>
                    <div class="shorts-track" id="shortsTrack">
                        {% for short in shorts %}
                            <a  href="{{ path('app_short', {'uuid': short.uuid}) }}" class="short-card">
                                <div class="short-thumb">
                                    {% if short.thumbnail is defined and short.thumbnail%}
                                        <img src="{{ asset(short.thumbnail) }}" alt="{{ short.title }}" loading="lazy">
                                    {% else %}
                                        <div class="short-thumb-placeholder"><i class="bi bi-phone"></i></div>
                                    {% endif %}
                                    <div class="short-overlay"></div>
                                    {% if short.duration is defined and short.duration %}
                                        <div class="short-duration">{{ short.duration }}</div>
                                    {% endif %}
                                    <div class="short-play"><i class="bi bi-play-fill text-white"></i></div>
                                </div>
                                <div class="short-info">
                                    <div class="short-title">{{ short.title }}</div>
                                    {% if short.views is defined and short.views %}
                                        <div class="short-views">{{ short.views }} vues</div>
                                    {% endif %}
                                </div>
                            </a>
                        {% endfor %}
                    </div>
                    <button class="scroll-btn scroll-btn-next" onclick="scrollTrack('shortsTrack', 1)"><i class="bi bi-chevron-right"></i></button>
                </div>
            {% else %}
                <div class="empty-bandeau">
                    <div class="empty-icon empty-icon-short"><i class="bi bi-phone"></i></div>
                    <h4>Aucun short disponible</h4>
                    <p>Les shorts apparaîtront ici dès qu'un créateur en publiera un.</p>
                </div>
            {% endif %}
        </div>
    </div>

    {# ============================================================ #}
    {# BANDEAU 3 — VIDÉOS                                           #}
    {# Alimenté par $videos dans le controller (isShort=false)      #}
    {# ============================================================ #}
    <div class="bandeau bandeau-videos">
        <div class="bandeau-header">
            <h2 class="section-title">
                <div class="section-title-accent"></div>
                <i class="bi bi-play-circle" style="color:var(--accent-video)"></i>
                Vidéos
            </h2>
            <a href="#" class="section-link link-video">Toutes les vidéos <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="bandeau-body">
            {% if videos is defined and videos|length > 0 %}
                <div class="video-grid">
                    {% for video in videos %}
                        <a  href="{{ path('app_watch', {'uuid': video.uuid}) }}" class="video-card" style="animation-delay:{{ loop.index0 * 0.05 }}s">
                            <div class="video-thumb">
                                {% if video.thumbnail is defined and video.thumbnail %}
                                    <img src="{{ asset(video.thumbnail) }}" alt="{{ video.title }}" loading="lazy">
                                {% else %}
                                    <div class="video-thumb-placeholder"><i class="bi bi-play-circle"></i></div>
                                {% endif %}
                                <div class="video-preview">
                                    <div class="play-btn-overlay"><i class="bi bi-play-fill text-white fs-5"></i></div>
                                </div>
                                {% if video.duration is defined and video.duration %}
                                    <span class="video-duration">{{ video.duration }}</span>
                                {% endif %}
                                <div class="video-actions-overlay">
                                    <button class="thumb-action-btn" onclick="event.preventDefault();event.stopPropagation();showToast('Ajouté à regarder plus tard','success')" title="Regarder plus tard"><i class="bi bi-clock"></i></button>
                                    <button class="thumb-action-btn" onclick="event.preventDefault();event.stopPropagation();showToast('Ajouté à la file','success')" title="File d\'attente"><i class="bi bi-plus-lg"></i></button>
                                </div>
                            </div>
                            <div class="video-info">
                                <div class="video-avatar">
                                    {% if video.uploaderpfp %}
                                        <img src="{{ asset(video.uploaderpfp) }}" alt="" loading="lazy">
                                    {% else %}
                                        <img src="{{ asset('uploads/ProfilePictures/default-avatar-profile-icon-vector-social-media-user-portrait.webp') }}" alt="avatar" loading="lazy">
                                    {% endif %}
                                </div>
                                <div class="video-meta">
                                    <div class="video-title">{{ video.title }}</div>
                                    <div class="video-channel">{% if video.uploaderusername is defined %}{{ video.uploaderusername}}{% endif %}</div>
                                    <div class="video-stats">
                                        {% if video.views is defined and video.views %}{{ video.views }} vues · {% endif %}
                                        {% if video.createdAt is defined %}{{ video.createdAt|date('d/m/Y') }}{% endif %}
                                    </div>
                                </div>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-bandeau">
                    <div class="empty-icon empty-icon-video"><i class="bi bi-camera-video"></i></div>
                    <h4>Aucune vidéo disponible</h4>
                    <p>Soyez le premier à publier une vidéo sur Starduste !</p>
                </div>
            {% endif %}
        </div>
    </div>

</main>

